<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="using:ReScene.Manager.Behaviors">

  <!-- Density parity (see Resources/Density.axaml): the Fluent CheckBox hardcodes Padding 8,0,0,0
       in a literal setter (not a resource), so the WPF 4px glyph→label gap needs a style. -->
  <Style Selector="CheckBox">
    <Setter Property="Padding" Value="4,0,0,0" />
  </Style>

  <!-- App-wide 14x14 glyph (CheckBoxGlyphSize, Density.axaml): Fluent hardcodes three 20px
       primitives in the CheckBox template — the box border, the check-glyph Viewbox (it scales
       its Path), and the glyph cell's wrapper Grid (which alone props the row height). Rows
       still measure CheckBoxMinHeight: height = max(MinHeight, content), so the smaller cell
       never pulls a labeled row under 20 — the versions tree reaches 16 only via its scoped
       MinHeight. CheckBoxGlyphTests pins both halves of that contract.

       The :not(.fullSizeGlyph) token is LOAD-BEARING twice over: (1) the template sets these
       sizes as direct attributes (BindingPriority.Template), and a selector made only of type
       tokens applies at Style priority, which Template BEATS — a class/pseudo token makes the
       style activator-based (StyleTrigger priority), which beats Template. Drop the :not and
       every setter here silently stops applying (probed live: bare/':is(Window)'/descendant
       forms all lose; class-bearing forms win). (2) Classes="fullSizeGlyph" is the documented
       OPT-OUT for surfaces where the glyph IS the pointer target (unlabeled DataGrid cells —
       see SampleRestorerView): opted-out boxes keep Fluent's 20x20 by simply not matching. -->
  <Style Selector="CheckBox:not(.fullSizeGlyph) /template/ Border#NormalRectangle">
    <Setter Property="Width" Value="{DynamicResource CheckBoxGlyphSize}" />
    <Setter Property="Height" Value="{DynamicResource CheckBoxGlyphSize}" />
  </Style>
  <Style Selector="CheckBox:not(.fullSizeGlyph) /template/ Viewbox">
    <Setter Property="Width" Value="{DynamicResource CheckBoxGlyphSize}" />
    <Setter Property="Height" Value="{DynamicResource CheckBoxGlyphSize}" />
  </Style>
  <Style Selector="CheckBox:not(.fullSizeGlyph) /template/ Grid:not(#RootGrid)">
    <Setter Property="Height" Value="{DynamicResource CheckBoxGlyphSize}" />
    <Setter Property="MinHeight" Value="0" />
    <!-- Fluent top-aligns the glyph cell (invisible while the 20px cell filled the row); the
         14px cell must CENTER or the box beaches ~3px above the label's centerline on 20px
         rows (user-reported, Output tab). Centering is safe by PATTERN, not luck: no app
         checkbox label wraps — long explanations live in SIBLING caption TextBlocks
         (SettingsWindow, ReconstructorView, wizards); keep it that way. -->
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Companion opt-out for a FUTURE wrapping label (none exists today): under magnification
       a box centered against a multi-line label can sit outside the viewport while the user
       reads line 1 — top alignment keeps the box co-visible with the label's start (a11y
       advisory). Distinct concern from .fullSizeGlyph (glyph SIZE vs ALIGNMENT). The reflow
       workstream (small-window backlog) must add this class the moment it gives the long
       option labels TextWrapping. Declared after the centering style so it wins the tie. -->
  <Style Selector="CheckBox.wrapLabel /template/ Grid:not(#RootGrid)">
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- Help is a flat, always-visible section on every task view: a bare body scroller, with no
       header, chevron or disclosure of any kind. It used to be a re-templated Expander whose
       toggle appeared only in compact mode, where the behavior also force-collapsed it to reclaim
       its height. The visible effect was a per-tab inconsistency nobody intended: whichever view
       went compact first at a given window height — the tallest one — was the only tab where help
       had to be clicked open, while every other tab showed the same text plainly. Compact mode
       still tightens the margin below and caps the body via HelpBodyMaxHeight; it no longer takes
       the help away. -->
  <Style Selector="ScrollViewer.helpSection">
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <!-- Compact-mode-ONLY margin tightening (never touches normal mode, so
       pixel-parity for TODAY's rendering is untouched — these rows' base margins
       are pre-existing, unchanged markup). Recovers a few DIPs toward the 307 CI bound from
       rows whose own content chrome (Button padding, caption line-height) runs a little over
       the design doc's own rough per-row estimates once actually measured. -->
  <Style Selector="DockPanel.actionBar">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="Grid.compactHeight ScrollViewer.helpSection">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Grid.compactHeight DockPanel.actionBar">
    <Setter Property="Margin" Value="0" />
  </Style>
  <!-- SRSReconstructor's pinned band: base values are today's pre-existing, unchanged
       markup (Border Padding="8,6" Margin="0,0,0,4"; separator Margin="0,4") — normal-mode
       rendering is untouched. Compact tightening closes a MEASURED gap: with the result
       banner's own 2-line MaxLines cap genuinely in play, the pinned band's
       natural height ran to 92 DIPs against the spec's <=75 ceiling; this recovers 20. -->
  <Style Selector="Border.resultBanner">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="Grid.compactHeight Border.resultBanner">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Border.pinnedSeparator">
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style Selector="Grid.compactHeight Border.pinnedSeparator">
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <!-- SampleRestorer's config band: the base value is ZERO — the config
       band's own StackPanel did not exist before this conversion (its content was a
       plain, unindented DockPanel column), so zero is the genuine "unchanged from today" value,
       not merely a convenient default. The 4px right-inset (the same scrollbar-clearance
       rationale as every other converted view's own house-rule content-panel inset) applies
       ONLY in compact mode, where the config band's own ScrollViewer can genuinely show a
       scrollbar; EXPANDED mode never needs it and must stay pixel-identical to today's markup. -->
  <Style Selector="StackPanel.compactScrollInset">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Grid.compactHeight StackPanel.compactScrollInset">
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <!-- No Expander-level MaxHeight: the behavior applies HelpBodyMaxHeight to the BODY's
       internal ScrollViewer only (a whole-control cap would squeeze the header). -->
  <!-- Body-scroller focusability is COMPACT-SCOPED (no new normal-mode
       Tab stop). The Reconstructor's body never takes this class-pair — its links are
       the route. ScrollViewerHomeEndKeys.Enabled closes a real platform gap (see that
       behavior's own doc): Avalonia's stock ScrollViewer.OnKeyDown wires PageUp/PageDown to
       its own paging methods but never wires Home/End to its own ScrollToHome/ScrollToEnd,
       despite the design doc's assumption that they "just work" alongside the Page keys.
       Set here (not per-view code-behind) so every view's own compact Help
       body inherits it for free. -->
  <Style Selector="ScrollViewer.helpBody">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="AutomationProperties.Name" Value="Help content" />
  </Style>
  <Style Selector="Grid.compactHeight ScrollViewer.helpBody">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="behaviors:ScrollViewerHomeEndKeys.Enabled" Value="True" />
  </Style>

  <!-- Compact tip (trimming is VISUAL-ONLY over the full bound
       text; HelpText carries it for AT; the tip is never a budget donor). Base Wrap value
       lives HERE (not as a local XAML value) so the compact override below can win — a local
       value on the element would outrank both style rules regardless of specificity. -->
  <Style Selector="TextBlock.tipLine">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Grid.compactHeight TextBlock.tipLine">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Splitter base + focus (base moves out of local values so :focus can win; >=3:1 vs
       both panes, asserted by test). -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="GridSplitter:focus">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <!-- 13px content text (see the ControlContentThemeFontSize note in Density.axaml). Avalonia's
       DEFAULT FontSize is already 12, so this style is enforcement against default/theme drift
       plus the written contract, not the supply. MUST be :is(Window) — a plain "Window" selector
       matches the style KEY, and every app window is a subclass (MainWindow, SettingsWindow, ...),
       so "Window" silently matches nothing. The real hazard is a root-level FontSize pin on a
       window: a LOCAL VALUE out-prioritizes this style and re-inflates every inheriting control
       (that was the shipped 14px regression) — PromptDialog is the one sanctioned pin (v1.9
       parity, 14). Popup-hosted trees (tooltips, menu flyouts) do not inherit from a Window —
       their themed content follows the Density resource instead. WindowFontSizeParityTests
       enforces the whole map. -->
  <Style Selector=":is(Window)">
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- WPF parity: v1.9 had NO press animation; Fluent scales Button/ToggleButton/RepeatButton
       to 0.98 on :pressed (transition-animated). The slide is width-proportional — each edge
       moves inward by 1% of width — so a full-row control (the Versions group header, Home
       recentItem rows) slides its left-edge content up to ~18px sideways DURING the press.
       Worse than cosmetic: RenderTransform moves the HIT bounds and IsPressed re-evaluates
       containment on pointer-move, so once the row slid out from under a parked pointer ANY
       pointer movement mid-press — even a zero-displacement re-evaluation — silently cancelled
       the activation (user-reported: "moves to the right, hard to click"). Pressed FEEDBACK
       stays where v1.9 had it: our button classes keep their distinct :pressed brushes
       (v1.9's five IsPressed triggers were all Button templates); link/toolbar/versionGroup
       header showing no during-hold change matches v1.9, whose Hyperlink/ToolbarToggleButton/
       Expander-header styles had no IsPressed trigger either. Style keys are matched exactly,
       so a future SplitButton/DropDownButton would need its own line (CheckBox/RadioButton
       need none — their themes have no press transform, drift-probed 0). PressStabilityTests
       pins the two user-facing surfaces. -->
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="ToggleButton:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="RepeatButton:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- WPF parity: WPF buttons center their content; Avalonia's Fluent Button theme sets no
       content alignment, so any button wider than its text (MinWidth Save/Cancel/Browse
       buttons) renders the label left-hugging. Button.link / Button.recentItem re-assert Left
       further down (later styles win), which is intentional for those. -->
  <Style Selector="Button">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Tab-strip band (pairs with the TabItemHeader* state brushes in Density.axaml): paint the
       tab row's items panel with the surface color so the full-width strip reads as a tab bar,
       WPF App.xaml:332-335 style. The Fluent TabControl's items host is a WrapPanel (the theme's
       own ^ styles target "ItemsPresenter#PART_ItemsPresenter > WrapPanel"), so this selector
       tracks the control theme's structure. -->
  <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
  </Style>
  <!-- Selection pipe: Fluent renders it text-width, hugging the header like a hyperlink underline.
       Make it the WPF selected-tab indicator instead — a 2px accent line across the FULL tab width
       at the bottom edge (WPF App.xaml:372-389). The negative margin mirrors the 12,6 TabItem
       padding (TabItemHeaderMargin in Density.axaml — keep the two in sync). Top placement only:
       every TabControl in the app uses top tabs. -->
  <Style Selector="TabItem[TabStripPlacement=Top] /template/ Border#PART_SelectedPipe">
    <Setter Property="Margin" Value="-12,0,-12,-6" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════
       ReScene Manager shared control style classes
       (functional-parity port of the ~10 SEMANTIC named styles from
       ReScene.NET/App.xaml — NOT a re-template of Fluent's own
       ControlThemes. Layered on top of <FluentTheme> in App.axaml.)

       Fluent's Button/ToggleButton/ListBoxItem ControlThemes already
       theme the templated *ContentPresenter* for :pointerover/:pressed/
       :selected via nested "^:state /template/ ContentPresenter" style
       rules baked into the control theme. A plain Setter on Button.X's
       own Background is NOT enough to change the hover/pressed color —
       Fluent's own state rule keeps re-applying its default brush on
       top of it. The documented Avalonia fix (see "How to style a
       control" in the Avalonia docs) is to add a MORE SPECIFIC selector
       — one that also requires our class — targeting the same
       "/template/ ContentPresenter" combinator; the extra class token
       gives it higher specificity than Fluent's own bare ":pointerover"
       rule, so ours wins without touching the template at all.
       ═══════════════════════════════════════════════════════════ -->

  <!-- ── Button.primary — accent-filled primary action button ──── -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource MediumRadius}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPressed}" />
  </Style>
  <Style Selector="Button.primary:disabled">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundDisabled}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  </Style>

  <!-- ── Button.cancel — subtle, destructive-leaning secondary button ── -->
  <Style Selector="Button.cancel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentError}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentError}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource MediumRadius}" />
  </Style>
  <!-- No AccentError-tint token exists yet; these opacity variants mirror the WPF
       CancelButton's literal hover/pressed brushes (#33/#55 over AccentError's RGB). -->
  <Style Selector="Button.cancel:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#33F44747" />
  </Style>
  <Style Selector="Button.cancel:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#55F44747" />
  </Style>
  <Style Selector="Button.cancel:disabled">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundDisabled}" />
  </Style>
  <Style Selector="Button.cancel:disabled /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  </Style>

  <!-- ── Button.ghost — transparent, low-emphasis button ────────── -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource MediumRadius}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <!-- Pressed feedback, consistent with Button.primary:pressed. Mirrors the WPF GhostButton IsPressed
       brush (#FF333333) — a step darker than the hover HoverBackground (#FF3E3E42). No neutral
       "pressed" token exists (like the cancel button's literal hover/pressed hexes above), so the WPF
       literal is used directly. -->
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#FF333333" />
  </Style>
  <Style Selector="Button.ghost:disabled">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundDisabled}" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- ── Button.link — hyperlink-styled button (About window links) ──── -->
  <!-- Transparent chrome + HyperlinkForeground token; the hover state brightens the text
       (HyperlinkHoverForeground) instead of underlining, since Avalonia's TextDecorations is not
       an inherited property and cannot be pushed from Button down into its ContentPresenter's
       implicit TextBlock via a style setter the way Foreground/FontWeight can. -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource HyperlinkForeground}" />
  </Style>
  <Style Selector="Button.link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource HyperlinkHoverForeground}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.link:disabled">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundDisabled}" />
  </Style>

  <!-- ── Button.statusVersion — muted status-bar version link ─────
       The MainWindow status-bar version link wants a MUTED rest color (grey, not Button.link's bright
       HyperlinkForeground) that still brightens on hover. It previously carried a LOCAL Foreground,
       which shadowed Button.link:pointerover (a local value outranks a style setter in Avalonia), so
       it never showed any hover affordance. Moving the rest color into a style setter (this class,
       declared AFTER .link so it wins at equal specificity) lets :pointerover override it. -->
  <Style Selector="Button.statusVersion">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondary}" />
  </Style>
  <Style Selector="Button.statusVersion:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource HyperlinkHoverForeground}" />
  </Style>

  <!-- ── ToggleButton.toolbar — compact ghost-style toolbar toggle ── -->
  <Style Selector="ToggleButton.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMedium}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,2" />
    <!-- Compact toolbar toggle: matches the WPF ToolbarToggleButton's explicit FontSize="11". -->
    <Setter Property="FontSize" Value="11" />
    <Setter Property="CornerRadius" Value="{DynamicResource MediumRadius}" />
  </Style>
  <Style Selector="ToggleButton.toolbar:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="ToggleButton.toolbar:checked">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ToggleButton.toolbar:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
  </Style>
  <Style Selector="ToggleButton.toolbar:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
  </Style>

  <!-- ── Button.recentItem — flat, left-aligned list-row button (Home) ── -->
  <Style Selector="Button.recentItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.recentItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="Button.recentItem:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ActiveBackground}" />
  </Style>

  <!-- ── TextBlock.mono — monospaced text ───────────────────────── -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MonoFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
  </Style>

  <!-- ── TextBlock.panelHeader — panel/section header caption ──── -->
  <Style Selector="TextBlock.panelHeader">
    <Setter Property="FontSize" Value="{DynamicResource SectionHeaderFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}" />
  </Style>

  <!-- ── Border.panelHeaderBar — header strip above a panel body ── -->
  <Style Selector="Border.panelHeaderBar">
    <Setter Property="Padding" Value="{DynamicResource PanelHeaderPadding}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelHeaderSeparatorBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- ── Border.section — bordered card used heavily by forms ──── -->
  <Style Selector="Border.section">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource LargeRadius}" />
    <Setter Property="Margin" Value="{DynamicResource SectionCardMargin}" />
  </Style>

  <!-- ── ListBox.logList — compact, monospaced log/terminal list ── -->
  <Style Selector="ListBox.logList">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource LogTerminalForeground}" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <!-- Auto-scroll to the newest log line as entries append (while the user is at the bottom).
         Mirrors the WPF shared log style; see Behaviors/ListBoxAutoScroll.cs. -->
    <Setter Property="behaviors:ListBoxAutoScroll.AutoScrollToEnd" Value="True" />
    <!-- Copy Line / Copy All Lines context menu + the platform copy chord, so getting text out of a
         log never requires a mouse drag-select; see Behaviors/LogListCopy.cs. -->
    <Setter Property="behaviors:LogListCopy.Enable" Value="True" />
    <!-- Scrollbars take layout space instead of overlaying: the Fluent overlay bar (Linux
         especially) draws ON the newest log line — the exact line auto-scroll keeps in view.
         Same rationale as the BruteForceProgressWindow version grid. -->
    <Setter Property="(ScrollViewer.AllowAutoHide)" Value="False" />
  </Style>
  <Style Selector="ListBox.logList ListBoxItem">
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="Foreground" Value="{DynamicResource LogTerminalForeground}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.logList ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="ListBox.logList ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedItemBackground}" />
  </Style>

  <!-- ── DataGridRow — alternating even-row tint ─────────────────
       Avalonia's DataGrid (11.3.13) has no AlternatingRowBackground (WPF did); this restores a subtle
       even-row stripe globally. SystemControlBackgroundListLowBrush (#FF2D2D30) sits one step above the
       grids' PanelBackground for a low-contrast band; odd rows keep the base background.

       Safety: the selector is limited to REST-state even rows via :not(:selected):not(:pointerover).
       An app-level style (this one) outranks the DataGrid control theme's own setters, so without the
       exclusions this even-row Background would win over the Fluent theme's :selected / :pointerover
       row backgrounds. Excluding those pseudo-classes de-activates this setter the moment a row is
       selected or hovered, letting the theme's selection/hover backgrounds show through. Diff tint in
       the Compare property grids is applied at the DataGridCell level (see FileCompareView) and renders
       on top of the row, so it always wins regardless of this row tint. -->
  <Style Selector="DataGridRow:nth-child(even):not(:selected):not(:pointerover)">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
  </Style>

  <!-- ── DataGrid header/cell density (WPF App.xaml:1173-1199) ────
       Fluent's DataGrid renders 14px column headers with generous padding, which overflows the fixed
       column widths ported verbatim from WPF (e.g. "Duration" clips to "Dura", "No Match" to "No Matc"
       on the brute-force grid). Restore WPF's compact chrome: 11px SemiBold secondary-color headers with
       6,4 padding and 6,3 cell padding, so those exact widths fit as they did in WPF. Applies to every
       grid; the Compare diff tint (a DataGridCell Background set in FileCompareView) and the alt-row tint
       above set different properties, so they compose. -->
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondary}" />
    <Setter Property="Padding" Value="6,4" />
    <!-- v1.9 parity (App.xaml:1172-1180): panel-toned header band with subtle right+bottom
         separators — the port originally dropped these two, leaving Fluent's near-black band
         (user report). 5.9:1 with the bumped ForegroundSecondary. All NINE grids keep
         CanUserSortColumns=False (VersionGrid was the stray inheriting Avalonia's TRUE default;
         v1.9 default-allowed sorting there but with WPF's own themed sort chrome — this flat
         band has no assessed interactive affordance, so sorting stays off; re-gate 2.4.7/hover
         through a11y before enabling it anywhere). -->
    <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSeparator}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <!-- Interior column boundaries: Fluent's separator Rectangle template-binds the header's
         SeparatorBrush and its stock value is a semi-transparent WHITE (#66FFFFFF) that reads
         bright on the panel-toned band; v1.9's separators were dark. (Styling the Rectangle's
         Fill directly does NOT work — the template-provided value outranks plain styles.) -->
    <Setter Property="SeparatorBrush" Value="{DynamicResource BorderSeparator}" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="6,3" />
  </Style>

  <!-- ── Expander.versionGroup — the WPF-classic expander look for the Versions tree ──
       User feedback preferred the v1.x WPF layout; the markup was always identical, the
       difference was pure theme chrome. This scoped re-template restores it: small LEFT
       chevron (a Path — Shapes expose no automation peer, so it is correctly invisible to
       AT), transparent text-height header instead of Fluent's full-width bar, content
       unboxed. The header stays a STOCK ToggleButton restyled by properties only, keeping
       Fluent's focus ring and Space/Enter handling; IsChecked MUST bind TwoWay
       (TemplateBinding defaults OneWay — one-way silently stops expansion). The
       ExpanderAutomationPeer rides on the control class, unaffected by the template;
       PART_ContentPresenter is the one registration-sensitive name. MinHeight 24 on the
       toggle is the 2.5.8 floor — the sole deliberate deviation from raw WPF density. -->
  <Style Selector="Expander.versionGroup">
    <!-- The group bar spans the tab like v1.9 even when collapsed (content no longer forces width). -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Faithful port of the v1.9 WPF custom Expander template (App.xaml:515-585 at the
             v1.9.0 tag): bordered rounded group, Surface header bar with hover, stroked MDL2-style
             chevron, Panel-tinted body. Deviations from exact-old, both invisible: the header
             stays a FOCUSABLE stock ToggleButton (v1.9 shipped Focusable=False - its header was
             keyboard-unreachable, a defect, not a look), and the chevron is a stroked Path rather
             than the Windows-only Segoe MDL2 font glyph (E76C/E70D) so Linux/macOS render it. -->
        <Border x:CompileBindings="False"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                CornerRadius="{DynamicResource MediumRadius}">
          <StackPanel>
            <!-- COUPLED VALUES: this Background pairs with the :checked override below (rest state
                 paints via TemplateBinding, expanded via the override — both must stay
                 SurfaceBackground or the header shifts color on expand). CornerRadius 3,3,0,0
                 mirrors MediumRadius (=3) so the header's top corners meet the outer Border's
                 radius exactly — retune one, retune both. -->
            <ToggleButton IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Header, StringFormat='RAR {0} versions'}"
                          Background="{DynamicResource SurfaceBackground}" BorderThickness="0"
                          Padding="8,6" MinHeight="24" CornerRadius="3,3,0,0"
                          Cursor="Hand"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- Stroked angle bracket approximating MDL2 E76C; :expanded rotates it 90deg to
                     the E70D down-chevron. Default RenderTransformOrigin IS Center - the string
                     "0.5,0.5" parses as an ABSOLUTE half-pixel and must never come back. -->
                <Path Name="ChevronGlyph" Data="M 1 1 L 5 5 L 1 9"
                      Stroke="{DynamicResource ForegroundSecondary}" StrokeThickness="1.3"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Width="10" Height="10" Stretch="Uniform"
                      VerticalAlignment="Center" />
                <ContentPresenter Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <!-- Visibility gated on the BORDER: gating only the presenter left a 1-2px empty
                 Panel-tinted sliver under every collapsed header. -->
            <Border Background="{DynamicResource PanelBackground}"
                    IsVisible="{TemplateBinding IsExpanded}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- v1.9 leaf density (user-measured v1.9 pitch 18px; 20px here since the 13px content text sized the rows past MinHeight 16). The 14px GLYPH half of this
       treatment was promoted app-wide 2026-07-29 (global CheckBox template styles above +
       CheckBoxGlyphSize token) — what stays scoped here is the DENSITY half: MinHeight 16 rows
       (16 + 2 margin = 18px pitch), accepted as a 2.5.8 deviation scoped to THIS dense version list
       only; invariants: header toggle keeps
       MinHeight >= 24, every leaf stays keyboard-reachable. FontSize 12 is enforcement against
       theme drift (content is 13 app-wide; see ControlContentThemeFontSize). Brushes remain
       untouched throughout, so the original contrast analysis carries. -->
  <Style Selector="Expander.versionGroup CheckBox">
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Expander.versionGroup:expanded /template/ Path#ChevronGlyph">
    <Setter Property="RenderTransform">
      <RotateTransform Angle="90" />
    </Setter>
  </Style>
  <!-- The v1.9 header states: Surface at rest AND expanded (state is the chevron, never color),
       Hover tint on mouse-over. These also suppress Fluent's accent-:checked painting. -->
  <Style Selector="Expander.versionGroup /template/ ToggleButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
  </Style>
  <Style Selector="Expander.versionGroup /template/ ToggleButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
  </Style>
  <Style Selector="Expander.versionGroup /template/ ToggleButton:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
  </Style>
  <Style Selector="Expander.versionGroup /template/ ToggleButton:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
  </Style>
  <Style Selector="Expander.versionGroup /template/ ToggleButton:checked:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
  </Style>

</Styles>
