<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ReScene.Manager.Controls"
             xmlns:behaviors="clr-namespace:ReScene.Manager.Behaviors"
             x:Class="ReScene.Manager.Views.SampleRestorerView"
             x:CompileBindings="False">

  <Grid Margin="{DynamicResource PageMargin}" x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />                 <!-- 0: Help -->
      <RowDefinition Height="Auto" />                 <!-- 1: config (AutoToStar) -->
      <RowDefinition Height="Auto" />                 <!-- 2: pinned action band -->
      <RowDefinition Height="*" MinHeight="80" />     <!-- 3: log band -->
    </Grid.RowDefinitions>

    <!-- ── Help ── A flat, always-visible section: one body scroller, no disclosure. It was an
         Expander until compact mode's habit of force-collapsing it made whichever view went
         compact first look like the only tab that hid its help behind a dropdown. Compact mode
         still bounds the body via CompactHeightBehavior.HelpBodyMaxHeight, set in the code-behind.
         Margin is NOT a local value (house rule: local values beat unconditional styles, so a
         local "0,0,0,6" would defeat the compact-mode margin tightening) — it lives in the
         helpSection style. -->
    <ScrollViewer Grid.Row="0" x:Name="HelpBody" Classes="helpSection helpBody"
                  VerticalScrollBarVisibility="Auto"
                  ScrollViewer.AllowAutoHide="False">
      <TextBlock Text="Restore media files using SRS data embedded in an SRR file. Select a directory containing the media files to restore — metadata and structure will be reconstructed and CRC-verified."
                 Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                 TextWrapping="Wrap" />
    </ScrollViewer>

    <!-- ── Config band (always-present; squeezes + scrolls in compact via AutoToStar) ──
         Content renders at natural height at normal size (row is Auto), no scrollbar shown.
         Classes="compactScrollInset" (NOT a local Margin):
         base value is zero, matching today's markup exactly (this StackPanel did not exist
         before this task; its content was a plain, unindented DockPanel column) — the 4px
         right-inset for scrollbar clearance applies ONLY in compact mode, via the style's own
         compact-scoped override below. A local, unconditional "0,0,4,0" here (an earlier version
         of this markup) changed EXPANDED-mode rendering too, which the frame-rig test's own
         row-0-only comparison did not cover — see FrameRig_NormalMode_ConfigBandCaptionMatchesPreChangeShape. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  ScrollViewer.AllowAutoHide="False">
      <StackPanel Classes="compactScrollInset">

        <!-- ── SRR File ──────────────────────────────────────────── -->
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
          <Run Text="SRR File " FontWeight="SemiBold" />
          <Run Text="— The .srr file containing embedded .srs sample data."
               Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
        </TextBlock>
        <DockPanel KeyboardNavigation.TabNavigation="Local">
          <!-- Naming convention for all three Browse buttons on this view, stated once here:
               "Browse for <target>", with the target phrased from that row's OWN visible caption
               subject, matching the Reconstructor's four and the Creator's. The bare Content
               "Browse" is not a usable label out of context — three buttons in this view alone
               render it — and because it IS the bare word, the shared phrasing is safe under WCAG
               2.5.3 (the accessible name contains the visible label). The one Browse button in the
               app that cannot take this phrasing is CreatorView's folder picker, whose Content
               reads "Browse folder…"; its own site records why. -->
          <Button DockPanel.Dock="Right" Content="Browse"
                  Command="{Binding BrowseSRRCommand}" TabIndex="2"
                  Classes="ghost"
                  AutomationProperties.Name="Browse for SRR file"
                  Margin="4,0,0,0" MinWidth="75" />
          <!-- AutomationProperties.Name: pre-existing a11y debt,
               unrelated to this task's own compact-layout work but discovered while wiring this
               control up as CompactHeightBehavior's RestoreFocusTarget — without it, a screen
               reader announced this TextBox with no accessible name at all. "SRR file path"
               mirrors CreatorView's own InputTextBox naming convention (a short "<subject> path"
               phrase, distinct from the longer visible caption sentence above). -->
          <TextBox x:Name="SRRFileTextBox" Text="{Binding SRRFilePath}" TabIndex="0"
                   AutomationProperties.Name="SRR file path"
                   behaviors:TextBoxDropBehavior.DropMode="File" />
        </DockPanel>
        <controls:FieldStatusLine Status="{Binding SRRStatus}" />

        <!-- separator -->
        <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

        <!-- ── Media Directory ───────────────────────────────────── -->
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
          <Run Text="Media Directory " FontWeight="SemiBold" />
          <Run Text="— Folder holding the full media files the samples were cut from. Files are matched to samples automatically."
               Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
        </TextBlock>
        <DockPanel KeyboardNavigation.TabNavigation="Local">
          <Button DockPanel.Dock="Right" Content="Browse"
                  Command="{Binding BrowseMediaDirectoryCommand}" TabIndex="2"
                  Classes="ghost"
                  AutomationProperties.Name="Browse for media directory"
                  Margin="4,0,0,0" MinWidth="75" />
          <!-- Same convention and the same reasoning as SRRFileTextBox above: a short
               "<subject> path" phrase whose subject is this row's OWN visible caption ("Media
               Directory"), so the accessible name contains the visible label (WCAG 2.5.3) without
               inheriting the caption's whole explanatory sentence as its name. -->
          <TextBox x:Name="MediaDirTextBox" Text="{Binding MediaDirectoryPath}" TabIndex="0"
                   AutomationProperties.Name="Media directory path"
                   behaviors:TextBoxDropBehavior.DropMode="Folder" />
        </DockPanel>
        <controls:FieldStatusLine Status="{Binding MatchStatus}" />

        <!-- separator -->
        <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

        <!-- ── Output Directory ──────────────────────────────────── -->
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
          <Run Text="Output Directory " FontWeight="SemiBold" />
          <Run Text="— Folder where restored samples will be written. Defaults to the media folder."
               Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
        </TextBlock>
        <DockPanel KeyboardNavigation.TabNavigation="Local">
          <Button DockPanel.Dock="Right" Content="Browse"
                  Command="{Binding BrowseOutputDirectoryCommand}" TabIndex="2"
                  Classes="ghost"
                  AutomationProperties.Name="Browse for output directory"
                  Margin="4,0,0,0" MinWidth="75" />
          <TextBox x:Name="OutputDirTextBox" Text="{Binding OutputDirectoryPath}" TabIndex="0"
                   AutomationProperties.Name="Output directory path"
                   behaviors:TextBoxDropBehavior.DropMode="Folder" />
        </DockPanel>

        <!-- separator -->
        <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

        <!-- ── SRS Entries DataGrid ──────────────────────────────── -->
        <TextBlock x:Name="SRSEntriesHeader" Text="Embedded SRS Files" FontWeight="SemiBold" Margin="0,0,0,2" />
        <!-- behaviors:ScrollHandoffBehavior.Handoff: the config band's own ScrollViewer clips this
             grid (fixed MinHeight 100 / MaxHeight 250) in compact mode — wheel input at the grid's
             own top/bottom extent, and keyboard navigation past the grid's own realized rows,
             both hand off to the OUTER (this ScrollViewer) rather than dead-ending at the grid's
             own edge. AutomationProperties.LabeledBy pairs the grid to its own header TextBlock
             above (mirrors the Log ListBox/LogHeader pairing below). -->
        <DataGrid x:Name="SRSEntriesGrid"
                  ItemsSource="{Binding SRSEntries}"
                  IsReadOnly="False"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  BorderThickness="0"
                  MinHeight="100"
                  MaxHeight="250"
                  AutomationProperties.LabeledBy="{Binding #SRSEntriesHeader}"
                  behaviors:ScrollHandoffBehavior.Handoff="True">
          <DataGrid.Columns>
            <!-- Authored (not DataGridCheckBoxColumn) so the cell checkbox can opt OUT of the
                 app-wide 14px glyph via Classes="fullSizeGlyph": this cell is UNLABELED, so the
                 glyph IS the pointer target — it keeps Fluent's default 20x20 size since an
                 unlabeled control needs a large enough hit target. The
                 automation name substitutes for the missing visual label. -->
            <DataGridTemplateColumn Header="" Width="30">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox Classes="fullSizeGlyph"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            AutomationProperties.Name="Restore this sample"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="SRS File" Binding="{Binding SRSFileName}" Width="200" IsReadOnly="True" />
            <DataGridTextColumn Header="Sample Name" Binding="{Binding SampleFileName}" Width="200" IsReadOnly="True" />
            <DataGridTextColumn Header="Media File" Binding="{Binding MediaFilePath}" Width="*" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="200" IsReadOnly="True" />
          </DataGrid.Columns>
        </DataGrid>

      </StackPanel>
    </ScrollViewer>

    <!-- ── Pinned action band — ALWAYS visible (this row and
         the log previously measured 0px height at 700×450 under the old DockPanel layout). Overlay/adorner
         implementations forbidden. The two separators bracketing it are the SAME two pre-existing
         Border elements from today's markup (relocated together, not duplicated); Margin "0,4" on
         both is TODAY's own verbatim value AND happens to match Classes="pinnedSeparator"'s own
         base value exactly (Styles.axaml), so applying it here is a zero-deviation,
         compact-only tightening with no normal-mode change. The action DockPanel and ProgressBar
         below keep their margins as LOCAL, verbatim values (0,0,0,2 / 0,0,0,4, unchanged from
         today) rather than the shared actionBar class — that class's own base margin (0,0,0,4)
         does not match this view's own pre-existing action-row margin (0,0,0,2); compact-mode
         tightening here is deferred until MEASURED to be needed. ── -->
    <StackPanel Grid.Row="2">
      <Border Classes="pinnedSeparator" Height="1" Background="{DynamicResource BorderSeparator}" />

      <!-- ── Action row ────────────────────────────────────────── -->
      <DockPanel Margin="0,0,0,2">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Restore All"
                  Command="{Binding RestoreCommand}"
                  Classes="primary"
                  Padding="16,4" Margin="0,0,4,0" />
          <Button Content="Cancel"
                  Command="{Binding CancelRestoreCommand}"
                  Classes="cancel"
                  IsVisible="{Binding IsRestoring}"
                  Padding="16,4" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding OverallProgressText}" Margin="0,0,8,0" />
          <TextBlock Text="{Binding ProgressMessage}"
                     IsVisible="{Binding ShowProgress}" />
        </StackPanel>
      </DockPanel>

      <!-- Progress bar -->
      <ProgressBar Value="{Binding ProgressPercent}"
                   Maximum="100" Height="18"
                   Margin="0,0,0,4"
                   IsVisible="{Binding ShowProgress}" />

      <Border Classes="pinnedSeparator" Height="1" Background="{DynamicResource BorderSeparator}" />
    </StackPanel>

    <!-- ── Log (fills remaining space) ───────────────────────── -->
    <DockPanel Grid.Row="3">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
        <Button DockPanel.Dock="Right" Content="Save log..."
                Command="{Binding SaveLogCommand}"
                Classes="ghost"
                Padding="8,2" />
        <TextBlock x:Name="LogHeader" DockPanel.Dock="Left" Text="Log" FontWeight="SemiBold" VerticalAlignment="Center" />
        <!-- Live save-outcome line (4.1.3): always in the tree — visibility-toggling would race
             the announcement; empty text renders nothing. No AutomationProperties.Name: the
             announced name IS the text. -->
        <TextBlock x:Name="SaveLogStatus" Text="{Binding SaveLogAnnouncement}"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
      </DockPanel>
      <ListBox ItemsSource="{Binding LogEntries}"
               Classes="logList"
               AutomationProperties.LabeledBy="{Binding #LogHeader}"
               FontFamily="{DynamicResource MonoFontFamily}"
               FontSize="{DynamicResource MonoFontSize}" />
    </DockPanel>

  </Grid>

</UserControl>
