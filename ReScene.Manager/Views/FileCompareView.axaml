<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ReScene.Manager.Controls"
             xmlns:sys="using:System"
             x:Class="ReScene.Manager.Views.FileCompareView"
             x:CompileBindings="False">

  <!-- Per-cell diff tint for the property DataGrids. Avalonia's DataGrid Fluent theme leaves the
       ROW's Background/Foreground unrendered inside cells (the cell theme sets its own Foreground,
       breaking inheritance, and the row's Background rectangle is separate), so the WPF DataGridRow
       DataTrigger is ported at the CELL level: DataGridCell's CellBorder Background and the cell
       ContentPresenter Foreground are both TemplateBound, so these setters render reliably. The cell's
       DataContext is the PropertyItem, so IsDifferent drives the tint. An indented "Property" name
       keeps its own (local) secondary Foreground, overriding the inherited AccentError — matching WPF.

       The Foreground uses the two-key converter form: non-diff cells must resolve a REAL brush
       (ForegroundPrimary), because an UnsetValue falls back to inherited Foreground, which does not
       reliably reach the alternating tinted rows — they then render TextBlock's black default (the
       same bug the Inspector grid had; see BoolToBrushConverter). The NAME column's TextBlock needs
       the same always-real-brush treatment one level deeper (IndentDiffBrushConverter): UnsetValue
       inherits on FIRST bind, but the grid repopulates per tree click and a RECYCLED container
       rebinding indented→plain lands on TextBlock's black default. The density/focus overrides mirror
       the Inspector's approved treatment: caption-size text instead of Fluent's 15px cell default,
       a compact row floor instead of MinHeight 32, and no white per-cell focus rectangle. -->
  <UserControl.Styles>
    <Style Selector="DataGrid.propertyGrid DataGridCell">
      <Setter Property="Background"
              Value="{Binding IsDifferent, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=DiffRowBackground}" />
      <Setter Property="Foreground"
              Value="{Binding IsDifferent, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=AccentError|ForegroundPrimary}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="DataGrid.propertyGrid DataGridCell:focus /template/ Grid#FocusVisual">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="{DynamicResource PageMargin}">

    <!-- ── Tab description ─────────────────────────────────── -->
    <TextBlock DockPanel.Dock="Top"
               Text="Compare two RAR, SRR, or SRS files side by side. Browse their block structures, view property differences, and inspect hex data to identify what changed between them."
               Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
               TextWrapping="Wrap" Margin="0,0,0,6" />

    <!-- ── File paths and controls ─────────────────────────── -->
    <Grid DockPanel.Dock="Top"
          Background="{DynamicResource SurfaceBackground}"
          ColumnDefinitions="*,Auto,*">

      <!-- Left file -->
      <DockPanel Grid.Column="0" Margin="6,4,2,4" x:Name="LeftDropZone"
                 KeyboardNavigation.TabNavigation="Local">
        <Button DockPanel.Dock="Right"
                Content="Close"
                Command="{Binding CloseLeftCommand}"
                IsEnabled="{Binding IsNotComparing}"
                Classes="ghost"
                ToolTip.Tip="Close left file"
                TabIndex="2"
                Margin="4,0,0,0"
                Padding="8,4" />
        <!-- This row has no caption TextBlock of its own — the side is the only thing that
             distinguishes it — so the target is "left file"/"right file", matching the vocabulary
             the sibling Close buttons' tooltips already use ("Close left file"). Safe under WCAG
             2.5.3: the visible label is the bare word "Browse", which the name contains. -->
        <Button DockPanel.Dock="Right"
                Content="Browse"
                Command="{Binding BrowseLeftCommand}"
                IsEnabled="{Binding IsNotComparing}"
                Classes="ghost"
                AutomationProperties.Name="Browse for left file"
                TabIndex="1"
                Margin="4,0,0,0"
                Padding="8,4" />
        <!-- Editable: type or paste a path and press Enter to load (no dialog needed). -->
        <TextBox x:Name="LeftFilePathTextBox"
                 Text="{Binding LeftFilePath}"
                 PlaceholderText="Type a path and press Enter, or Browse"
                 TabIndex="0"
                 FontSize="{DynamicResource FontSizeBody}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding LoadLeftFromPathCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
      </DockPanel>

      <!-- Swap button centered between sides -->
      <Button Grid.Column="1"
              Content="Swap"
              Command="{Binding SwapCommand}"
              IsEnabled="{Binding IsNotComparing}"
              Classes="ghost"
              ToolTip.Tip="Swap left and right files"
              Margin="2,4"
              Padding="8,4" />

      <!-- Right file -->
      <DockPanel Grid.Column="2" Margin="2,4,6,4" x:Name="RightDropZone"
                 KeyboardNavigation.TabNavigation="Local">
        <Button DockPanel.Dock="Right"
                Content="Close"
                Command="{Binding CloseRightCommand}"
                IsEnabled="{Binding IsNotComparing}"
                Classes="ghost"
                ToolTip.Tip="Close right file"
                TabIndex="2"
                Margin="4,0,0,0"
                Padding="8,4" />
        <Button DockPanel.Dock="Right"
                Content="Browse"
                Command="{Binding BrowseRightCommand}"
                IsEnabled="{Binding IsNotComparing}"
                Classes="ghost"
                AutomationProperties.Name="Browse for right file"
                TabIndex="1"
                Margin="4,0,0,0"
                Padding="8,4" />
        <!-- Editable: type or paste a path and press Enter to load (no dialog needed). -->
        <TextBox x:Name="RightFilePathTextBox"
                 Text="{Binding RightFilePath}"
                 PlaceholderText="Type a path and press Enter, or Browse"
                 TabIndex="0"
                 FontSize="{DynamicResource FontSizeBody}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding LoadRightFromPathCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
      </DockPanel>
    </Grid>

    <!-- ── Status bar ──────────────────────────────────────── -->
    <Border DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource StatusSeparatorBrush}"
            BorderThickness="0,1,0,0"
            Background="{DynamicResource SurfaceBackground}"
            Padding="6,3">
      <TextBlock Text="{Binding StatusMessage}"
                 FontSize="{DynamicResource StatusBarFontSize}"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Border>

    <!-- ── Main content: two-panel compare ─────────────────── -->
    <Grid ColumnDefinitions="*,Auto,*">

      <!-- Left Panel -->
      <Grid Grid.Column="0" Margin="2" RowDefinitions="*,Auto,2*">

        <!-- Left Tree -->
        <Border Classes="section">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="panelHeaderBar">
              <TextBlock Classes="panelHeader" Text="Left Structure" />
            </Border>

            <TreeView ItemsSource="{Binding LeftTreeRoots}"
                      SelectionChanged="OnLeftTreeSelectionChanged"
                      FontSize="{DynamicResource FontSizeBody}">
              <TreeView.Styles>
                <Style Selector="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                  <!-- Two-key on purpose: TreeNodeViewModel.IsDifferent is [ObservableProperty], so
                       an IN-PLACE flip true->false re-evaluates the binding — a single-key UnsetValue
                       lands on TextBlock's black default (peer-proven); it just never fires today
                       because CompareHighlighter only ever SETS the flag. BaseHigh (#FFF) matches the
                       tree's measured inherited steady state exactly — NOT ForegroundPrimary
                       (#D4D4D4), which would visibly dim every plain label. -->
                  <TextBlock Text="{Binding Text}"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{Binding IsDifferent, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=AccentError|SystemControlForegroundBaseHighBrush}" />
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Row="1"
                      Height="{DynamicResource SplitterHeight}"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext" />

        <!-- Left Properties + Hex -->
        <Grid Grid.Row="2" RowDefinitions="*,Auto,*">

          <!-- Left Properties -->
          <Border Classes="section">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="panelHeaderBar">
                <TextBlock Classes="panelHeader" Text="Left Properties" />
              </Border>

              <DataGrid x:Name="LeftPropertiesGrid"
                        Classes="propertyGrid"
                        ItemsSource="{Binding LeftProperties}"
                        SelectedItem="{Binding SelectedLeftProperty}"
                        IsReadOnly="True"
                        CanUserResizeColumns="True"
                        CanUserReorderColumns="False"
                        CanUserSortColumns="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        SelectionMode="Single"
                        BorderThickness="0"
                        AutoGenerateColumns="False">
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy Name" Click="OnCopyPropertyNameClick" />
                    <MenuItem Header="Copy Value" Click="OnCopyPropertyValueClick" />
                    <Separator />
                    <MenuItem Header="Copy Name: Value" Click="OnCopyPropertyClick" />
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Property" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="{Binding IsIndented, Converter={StaticResource IndentToMarginConverter}}">
                          <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource IndentDiffBrushConverter}">
                              <Binding Path="IsIndented" />
                              <Binding Path="IsDifferent" />
                            </MultiBinding>
                          </TextBlock.Foreground>
                        </TextBlock>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <!-- Splitter -->
          <GridSplitter Grid.Row="1"
                        Height="{DynamicResource SplitterHeight}"
                        HorizontalAlignment="Stretch"
                        ResizeDirection="Rows"
                        ResizeBehavior="PreviousAndNext" />

          <!-- Left Hex View -->
          <Border Grid.Row="2" Classes="section">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="panelHeaderBar">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                              HorizontalAlignment="Right" Margin="0,0,4,0">
                    <TextBlock Text="Bytes/Row:" VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundSecondary}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Margin="0,0,4,0" />
                    <!-- Preset bytes-per-row dropdown; see InspectorView for the Avalonia ComboBox
                         (non-editable) rationale. Int32 items so SelectedItem round-trips the int. -->
                    <ComboBox SelectedItem="{Binding HexBytesPerLine}"
                              Width="64" Padding="8,3"
                              FontSize="{DynamicResource FontSizeCaption}"
                              VerticalAlignment="Center">
                      <sys:Int32>8</sys:Int32>
                      <sys:Int32>16</sys:Int32>
                      <sys:Int32>24</sys:Int32>
                      <sys:Int32>32</sys:Int32>
                      <sys:Int32>48</sys:Int32>
                      <sys:Int32>64</sys:Int32>
                    </ComboBox>
                  </StackPanel>
                  <TextBlock Classes="panelHeader" Text="Left Hex View" />
                </DockPanel>
              </Border>

              <controls:HexView DataSource="{Binding LeftHexDataSource}"
                                BlockOffset="{Binding LeftHexBlockOffset}"
                                BlockLength="{Binding LeftHexBlockLength}"
                                SelectionOffset="{Binding LeftHexSelectionOffset}"
                                SelectionLength="{Binding LeftHexSelectionLength}"
                                DiffRanges="{Binding LeftDiffRanges}"
                                BytesPerLine="{Binding HexBytesPerLine}" />
            </DockPanel>
          </Border>

        </Grid>
      </Grid>

      <!-- Center Splitter -->
      <GridSplitter Grid.Column="1"
                    Width="{DynamicResource SplitterWidth}"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext" />

      <!-- Right Panel -->
      <Grid Grid.Column="2" Margin="2" RowDefinitions="*,Auto,2*">

        <!-- Right Tree -->
        <Border Classes="section">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="panelHeaderBar">
              <TextBlock Classes="panelHeader" Text="Right Structure" />
            </Border>

            <TreeView ItemsSource="{Binding RightTreeRoots}"
                      SelectionChanged="OnRightTreeSelectionChanged"
                      FontSize="{DynamicResource FontSizeBody}">
              <TreeView.Styles>
                <Style Selector="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                  <!-- Two-key on purpose: TreeNodeViewModel.IsDifferent is [ObservableProperty], so
                       an IN-PLACE flip true->false re-evaluates the binding — a single-key UnsetValue
                       lands on TextBlock's black default (peer-proven); it just never fires today
                       because CompareHighlighter only ever SETS the flag. BaseHigh (#FFF) matches the
                       tree's measured inherited steady state exactly — NOT ForegroundPrimary
                       (#D4D4D4), which would visibly dim every plain label. -->
                  <TextBlock Text="{Binding Text}"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{Binding IsDifferent, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=AccentError|SystemControlForegroundBaseHighBrush}" />
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Row="1"
                      Height="{DynamicResource SplitterHeight}"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext" />

        <!-- Right Properties + Hex -->
        <Grid Grid.Row="2" RowDefinitions="*,Auto,*">

          <!-- Right Properties -->
          <Border Classes="section">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="panelHeaderBar">
                <TextBlock Classes="panelHeader" Text="Right Properties" />
              </Border>

              <DataGrid x:Name="RightPropertiesGrid"
                        Classes="propertyGrid"
                        ItemsSource="{Binding RightProperties}"
                        SelectedItem="{Binding SelectedRightProperty}"
                        IsReadOnly="True"
                        CanUserResizeColumns="True"
                        CanUserReorderColumns="False"
                        CanUserSortColumns="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        SelectionMode="Single"
                        BorderThickness="0"
                        AutoGenerateColumns="False">
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy Name" Click="OnCopyPropertyNameClick" />
                    <MenuItem Header="Copy Value" Click="OnCopyPropertyValueClick" />
                    <Separator />
                    <MenuItem Header="Copy Name: Value" Click="OnCopyPropertyClick" />
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Property" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="{Binding IsIndented, Converter={StaticResource IndentToMarginConverter}}">
                          <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource IndentDiffBrushConverter}">
                              <Binding Path="IsIndented" />
                              <Binding Path="IsDifferent" />
                            </MultiBinding>
                          </TextBlock.Foreground>
                        </TextBlock>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <!-- Splitter -->
          <GridSplitter Grid.Row="1"
                        Height="{DynamicResource SplitterHeight}"
                        HorizontalAlignment="Stretch"
                        ResizeDirection="Rows"
                        ResizeBehavior="PreviousAndNext" />

          <!-- Right Hex View -->
          <Border Grid.Row="2" Classes="section">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="panelHeaderBar">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                              HorizontalAlignment="Right" Margin="0,0,4,0">
                    <TextBlock Text="Bytes/Row:" VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundSecondary}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Margin="0,0,4,0" />
                    <!-- Preset bytes-per-row dropdown; see InspectorView for the Avalonia ComboBox
                         (non-editable) rationale. Int32 items so SelectedItem round-trips the int. -->
                    <ComboBox SelectedItem="{Binding HexBytesPerLine}"
                              Width="64" Padding="8,3"
                              FontSize="{DynamicResource FontSizeCaption}"
                              VerticalAlignment="Center">
                      <sys:Int32>8</sys:Int32>
                      <sys:Int32>16</sys:Int32>
                      <sys:Int32>24</sys:Int32>
                      <sys:Int32>32</sys:Int32>
                      <sys:Int32>48</sys:Int32>
                      <sys:Int32>64</sys:Int32>
                    </ComboBox>
                  </StackPanel>
                  <TextBlock Classes="panelHeader" Text="Right Hex View" />
                </DockPanel>
              </Border>

              <controls:HexView DataSource="{Binding RightHexDataSource}"
                                BlockOffset="{Binding RightHexBlockOffset}"
                                BlockLength="{Binding RightHexBlockLength}"
                                SelectionOffset="{Binding RightHexSelectionOffset}"
                                SelectionLength="{Binding RightHexSelectionLength}"
                                DiffRanges="{Binding RightDiffRanges}"
                                BytesPerLine="{Binding HexBytesPerLine}" />
            </DockPanel>
          </Border>

        </Grid>
      </Grid>

      <!-- Drop zone overlays (shown during drag; toggled from code-behind) -->
      <Border x:Name="LeftDropOverlay"
              Grid.Column="0"
              Background="{DynamicResource DropTargetBackground}"
              BorderBrush="{DynamicResource DropTargetBorder}"
              BorderThickness="2"
              CornerRadius="4"
              Margin="2"
              IsVisible="False"
              IsHitTestVisible="False">
        <TextBlock Text="Drop here for Left"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource FontSizeH1}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource OverlayForeground}" />
      </Border>

      <Border x:Name="RightDropOverlay"
              Grid.Column="2"
              Background="{DynamicResource DropTargetBackground}"
              BorderBrush="{DynamicResource DropTargetBorder}"
              BorderThickness="2"
              CornerRadius="4"
              Margin="2"
              IsVisible="False"
              IsHitTestVisible="False">
        <TextBlock Text="Drop here for Right"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource FontSizeH1}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource OverlayForeground}" />
      </Border>

      <!-- Busy overlay: shown while a comparison runs (work happens off the UI thread). -->
      <Border Grid.Column="0" Grid.ColumnSpan="3"
              Background="{DynamicResource OverlayScrimBackground}"
              IsVisible="{Binding IsComparing}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="240">
          <TextBlock Text="Comparing files…"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,8"
                     Foreground="{DynamicResource OverlayForeground}" />
          <ProgressBar IsIndeterminate="True" Height="6" />
        </StackPanel>
      </Border>

    </Grid>

  </DockPanel>

</UserControl>
