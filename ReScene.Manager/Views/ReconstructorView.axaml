<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ReScene.Manager.Controls"
             xmlns:behaviors="clr-namespace:ReScene.Manager.Behaviors"
             xmlns:vm="clr-namespace:ReScene.App.Core.ViewModels;assembly=ReScene.App.Core"
             x:Class="ReScene.Manager.Views.ReconstructorView"
             x:CompileBindings="False">

  <Grid Margin="{DynamicResource PageMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="130" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1*" MinHeight="80" />
    </Grid.RowDefinitions>

    <!-- ── Help ── A flat, always-visible section: one body scroller, no disclosure. It was an
         Expander until compact mode's habit of force-collapsing it made whichever view went
         compact first look like the only tab that hid its help behind a dropdown. Compact mode
         still bounds the body via CompactHeightBehavior.HelpBodyMaxHeight, set in the code-behind.
         Margin is NOT a local value (house rule: local values beat unconditional styles, so a
         local "0,0,0,6" would defeat the compact-mode margin tightening) — it lives in the
         helpSection style. -->
      <!-- The BODY ScrollViewer is the HelpBodyMaxHeight target. NO helpBody class and never
           focusable — the Reconstructor's links are the keyboard route (the
           class-pair would make it compact-focusable). Inset on the content panel per house rule. -->
    <ScrollViewer Grid.Row="0" x:Name="HelpBody" Classes="helpSection"
                  AutomationProperties.Name="Help &amp; links"
                  VerticalScrollBarVisibility="Auto"
                  ScrollViewer.AllowAutoHide="False">
      <StackPanel Margin="0,0,4,0">
        <TextBlock Text="Reconstruct original RAR archives from an SRR file by brute-forcing WinRAR compression settings. Provide the source files and a WinRAR executable, then configure which RAR versions and switches to try."
                   Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                   TextWrapping="Wrap" />
        <!-- WPF inline Hyperlinks have no Avalonia equivalent; the "download from … or …" line becomes a
             caption plus link-class Buttons that open through the SystemLauncherService (see code-behind).
             Every link carries its platform qualifier — the FTP-originals archive contains only the
             Windows binaries. The comma TextBlock carries the gap so it renders flush against the first
             link. -->
        <WrapPanel Margin="0,2,0,0">
          <TextBlock Text="WinRAR versions needed for reconstruction can be downloaded from:"
                     Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                     VerticalAlignment="Center" Margin="0,0,4,0" />
          <Button x:Name="WindowsPackLink" Classes="link" Content="Extracted files for Windows (ready to use)"
                  Tag="https://drive.google.com/file/d/1of053kS2Wxk-foHN_ALRu-u6Tcck58yn/view?usp=drive_link"
                  Click="OnResourceLinkClick"
                  FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center" />
          <TextBlock Text=","
                     Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                     VerticalAlignment="Center" Margin="0,0,4,0" />
          <Button Classes="link" Content="Extracted files for Linux (ready to use)"
                  Tag="https://drive.google.com/file/d/1TcpA7RXoTUEr3pHZ8-4YTcQFRGZYP7v_/view?usp=drive_link"
                  Click="OnResourceLinkClick"
                  FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center" Margin="0,0,4,0" />
          <TextBlock Text="or"
                     Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                     VerticalAlignment="Center" Margin="0,0,4,0" />
          <Button Classes="link" Content="Original files from RAR FTP (Windows)"
                  Tag="https://drive.google.com/file/d/1hvgzSY6YH_ZS3cpy7bHcw2zpjiwuP_Xi/view?usp=drive_link"
                  Click="OnResourceLinkClick"
                  FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center" />
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ── Persistent action bar ─────────────────────────────
         Margin is NOT a local value (same reason as the Expander above: a compact-mode
         margin-tightening style needs to be able to win). -->
    <DockPanel Grid.Row="1" Classes="actionBar">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Export Config"
                Command="{Binding ExportConfigCommand}"
                Classes="ghost"
                ToolTip.Tip="Save the current paths and options to a configuration JSON file for reuse."
                Padding="12,4" Margin="0,0,4,0" />
        <Button Content="Start"
                Command="{Binding StartCommand}"
                Classes="primary"
                Padding="16,4" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="Import Config"
                Command="{Binding ImportConfigCommand}"
                Classes="ghost"
                ToolTip.Tip="Load all paths and options from a previously-exported configuration JSON file."
                Padding="12,4" Margin="0,0,4,0" />
        <Button Content="Import from SRR"
                Command="{Binding ImportSRRCommand}"
                Classes="primary"
                ToolTip.Tip="Import settings from an SRR file. Auto-configures compression, dictionary, versions, timestamps, and Host OS."
                Padding="12,4" />
      </StackPanel>
    </DockPanel>

    <!-- ── Import-from-SRR tip ─────────────────────────────── -->
    <!-- Always-visible, compact-trimmed to preserve accessibility: trimming is
         VISUAL-ONLY over the full bound text; ToolTip + HelpText both carry the
         full text; the tip is never the budget donor. -->
    <!-- TextWrapping is NOT a local value here (house rule: local values beat unconditional
         styles, so a local Wrap would defeat the compact-mode NoWrap override below) — the
         base Wrap value lives in the tipLine style instead, so the compact-scoped descendant
         selector can win by specificity. -->
    <TextBlock Grid.Row="2" Classes="tipLine"
               Text="Tip: click &#x201C;Import from SRR&#x201D; to auto-configure versions, compression, dictionary, timestamps and Host OS from the release's SRR."
               ToolTip.Tip="{Binding $self.Text}"
               AutomationProperties.HelpText="{Binding $self.Text}"
               Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
               Margin="0,0,0,4" />

    <!-- ── Custom packer warning ───────────────────────────── -->
    <Border Grid.Row="3"
            IsVisible="{Binding HasCustomPackerWarning}"
            Background="{DynamicResource WarningBannerBackground}"
            BorderBrush="{DynamicResource WarningBannerBorder}" BorderThickness="1"
            CornerRadius="3" Margin="0,0,0,4" Padding="8,5">
      <TextBlock Text="{Binding CustomPackerWarning}"
                 Foreground="{DynamicResource WarningForeground}"
                 FontSize="{DynamicResource FontSizeBody}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- ── Settings sub-tabs ───────────────────────────────── -->
    <TabControl Grid.Row="4" MinHeight="130">

      <!-- Paths (default) -->
      <!-- A composite header leaves the TabItem peer nothing to name itself from, so it fell back
           to its BODY's ToString() and announced as "Avalonia.Controls.ScrollViewer" (4.1.2). The
           name comes from the VM rather than a literal because it also has to carry the warning
           glyph's signal: the glyph is a purely visual cue, and MEASURED, a TabItem peer does not
           expose its header's TextBlocks as children at all — so without this the "needs
           attention" state reaches a screen reader through no channel whatsoever. -->
      <TabItem AutomationProperties.Name="{Binding PathsTabAccessibleName}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Paths" VerticalAlignment="Center" />
            <TextBlock Text="&#x26A0;" Margin="6,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentWarning}"
                       IsVisible="{Binding PathsNeedAttention}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False">
          <StackPanel Margin="4">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
              <Run Text="WinRAR " FontWeight="SemiBold" />
              <Run Text="— Folder containing WinRAR version subfolders used to recompress. Older releases need older WinRAR versions."
                   Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
            </TextBlock>
            <!-- Naming convention for all four picker rows on this tab, stated once here:
                 · The Browse buttons take their names VERBATIM from ReconstructWizardBody, which
                   already ships exactly these four strings for these same four commands. Same
                   function, same name (WCAG 3.2.4 Consistent Identification) — and no new string
                   had to be invented for any of them.
                 · The TextBoxes use the "<subject> path" convention CreatorView/SampleRestorerView
                   already use, with the subject taken from the row's OWN visible caption so the
                   accessible name CONTAINS the visible label (WCAG 2.5.3 Label in Name). That is
                   why the third is "Verify file path" and not "Verification file path": this tab's
                   caption reads "Verify". The wizard's own field is LabeledBy a caption that reads
                   "Verification file (.sfv or .sha1)", so the two surfaces differ — each name
                   matches its OWN visible label, which is what 2.5.3 requires.
                 · Association with the caption: Avalonia 11.3.18 has no
                   AutomationProperties.DescribedBy (MEASURED — the attached class exposes
                   LabeledBy and HelpText and nothing else), and these captions are subject+prose
                   sentences, so LabeledBy would make the whole sentence the field's NAME. An
                   explicit short name is used instead; the caption stays an adjacent text node,
                   which is where a screen reader reads it in document order anyway. -->
            <DockPanel Margin="0,0,0,2" KeyboardNavigation.TabNavigation="Local">
              <Button DockPanel.Dock="Right" Content="Browse"
                      TabIndex="1"
                      Command="{Binding BrowseWinRARCommand}"
                      Classes="ghost"
                      AutomationProperties.Name="Browse for WinRAR versions folder"
                      Margin="4,0,0,0" MinWidth="75" />
              <TextBox x:Name="WinRARTextBox" Text="{Binding WinRARPath}"
                       TabIndex="0"
                       AutomationProperties.Name="WinRAR versions folder path"
                       behaviors:TextBoxDropBehavior.DropMode="Folder" />
            </DockPanel>
            <controls:FieldStatusLine Status="{Binding WinRARStatus}" Margin="0,1,0,2" />

            <TextBlock TextWrapping="Wrap" Margin="0,8,0,2">
              <Run Text="Release " FontWeight="SemiBold" />
              <Run Text="— Folder with the extracted original files to recompress into RAR archives."
                   Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
            </TextBlock>
            <DockPanel Margin="0,0,0,2" KeyboardNavigation.TabNavigation="Local">
              <Button DockPanel.Dock="Right" Content="Browse"
                      TabIndex="1"
                      Command="{Binding BrowseReleaseCommand}"
                      Classes="ghost"
                      AutomationProperties.Name="Browse for extracted release files"
                      Margin="4,0,0,0" MinWidth="75" />
              <TextBox x:Name="ReleaseTextBox" Text="{Binding ReleasePath}"
                       TabIndex="0"
                       AutomationProperties.Name="Release files path"
                       behaviors:TextBoxDropBehavior.DropMode="Folder" />
            </DockPanel>
            <controls:FieldStatusLine Status="{Binding ReleaseStatus}" Margin="0,1,0,2" />

            <TextBlock TextWrapping="Wrap" Margin="0,8,0,2">
              <Run Text="Verify " FontWeight="SemiBold" />
              <Run Text="— The .sfv or .sha1 file to verify reconstructed archives against."
                   Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
            </TextBlock>
            <DockPanel Margin="0,0,0,2" KeyboardNavigation.TabNavigation="Local">
              <Button DockPanel.Dock="Right" Content="Browse"
                      TabIndex="1"
                      Command="{Binding BrowseVerificationCommand}"
                      Classes="ghost"
                      AutomationProperties.Name="Browse for verification file"
                      Margin="4,0,0,0" MinWidth="75" />
              <TextBox x:Name="VerifyTextBox" Text="{Binding VerificationPath}"
                       TabIndex="0"
                       AutomationProperties.Name="Verify file path"
                       behaviors:TextBoxDropBehavior.DropMode="File" />
            </DockPanel>
            <controls:FieldStatusLine Status="{Binding VerifyStatus}" Margin="0,1,0,2" />

            <TextBlock TextWrapping="Wrap" Margin="0,8,0,2">
              <Run Text="Output " FontWeight="SemiBold" />
              <Run Text="— Folder where reconstructed RAR archives are written."
                   Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
            </TextBlock>
            <DockPanel Margin="0,0,0,2" KeyboardNavigation.TabNavigation="Local">
              <Button DockPanel.Dock="Right" Content="Browse"
                      TabIndex="1"
                      Command="{Binding BrowseOutputCommand}"
                      Classes="ghost"
                      AutomationProperties.Name="Browse for output folder"
                      Margin="4,0,0,0" MinWidth="75" />
              <TextBox x:Name="OutputTextBox" Text="{Binding OutputPath}"
                       TabIndex="0"
                       AutomationProperties.Name="Output folder path"
                       behaviors:TextBoxDropBehavior.DropMode="Folder" />
            </DockPanel>
            <controls:FieldStatusLine Status="{Binding OutputStatus}" Margin="0,1,0,2" />

            <controls:FieldStatusLine Status="{Binding ArchiveSetStatus}" Margin="0,1,0,2" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Versions -->
      <TabItem Header="Versions">
        <ScrollViewer VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False">
          <StackPanel Margin="4">
            <TextBlock Text="The WinRAR versions to try. Only versions found in your WinRAR versions folder are listed — tick the ones you think produced the release."
                       TextWrapping="Wrap" Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Content="Rescan" Command="{Binding RescanVersionsCommand}"
                      Classes="ghost" Margin="4,0,0,0" MinWidth="70" />
              <Button DockPanel.Dock="Right" Content="None" Command="{Binding SelectNoVersionsCommand}"
                      Classes="ghost" Margin="4,0,0,0" MinWidth="55" />
              <Button DockPanel.Dock="Right" Content="All" Command="{Binding SelectAllVersionsCommand}"
                      Classes="ghost" Margin="4,0,0,0" MinWidth="55" />
              <TextBlock Text="" />
            </DockPanel>

            <TextBlock Text="No WinRAR versions found. Set the WinRAR versions folder on the Files tab, then Rescan."
                       TextWrapping="Wrap" Foreground="{DynamicResource ForegroundSecondary}"
                       FontSize="{DynamicResource FontSizeCaption}" Margin="0,4"
                       IsVisible="{Binding ShowNoVersionsHint}" />

            <ItemsControl ItemsSource="{Binding VersionGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- Collapsible major-version group: the expander arrow toggles expansion; the
                       checkbox toggles all leaves. Groups with ticked leaves start expanded. The
                       WPF bound Run.Text runs are restructured here as horizontal TextBlocks because
                       Avalonia Inlines do not inherit the item DataContext for bindings. -->
                  <!-- versionGroup restores the WPF-classic expander chrome (left chevron, plain
                       text-height header) — see the scoped template in Resources/Styles.axaml.
                       The explicit AutomationProperties.Name entries exist because Avalonia does
                       not derive names from panel content: without them every checkbox on this
                       tab reads as an unnamed checkbox to a screen reader (4.1.2). -->
                  <Expander Classes="versionGroup" IsExpanded="{Binding IsExpanded}" Margin="0,2,0,0">
                    <Expander.Header>
                      <CheckBox IsThreeState="True" IsChecked="{Binding IsChecked, Mode=OneWay}"
                                Command="{Binding ToggleAllCommand}"
                                AutomationProperties.Name="{Binding Header, StringFormat='Select all RAR {0} versions'}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="RAR " />
                          <TextBlock Text="{Binding Header}" />
                          <TextBlock Text="  " />
                          <TextBlock Text="{Binding CountText}" />
                        </StackPanel>
                      </CheckBox>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Leaves}" Margin="24,2,0,4">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <!-- Fixed width keeps the wrap columns aligned; the tooltip carries the
                               full folder name. -->
                          <!-- 226, not the WPF 230: the fixed-position scrollbar (16px, the Linux
                               overlay fix) plus the group border eat the old slack — at 1920w the
                               wrap got exactly 8x230 with zero margin, so the 8th column vanished
                               whenever the bar showed. Labels never fill the width; TextTrimming
                               guards the rest. -->
                          <CheckBox IsChecked="{Binding IsChecked}" ToolTip.Tip="{Binding FolderName}"
                                    AutomationProperties.Name="{Binding AccessibleName}"
                                    Margin="0,1" Width="226">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding LabelWithTag}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="  " />
                              <TextBlock Text="{Binding FolderDisplay}" TextTrimming="CharacterEllipsis"
                                         Foreground="{DynamicResource ForegroundSecondary}" />
                            </StackPanel>
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Compression -->
      <TabItem Header="Compression">
        <ScrollViewer VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False">
          <StackPanel Margin="4">
            <TextBlock Text="Select the switches to pass on to the RAR process. If a switch is not supported by a RAR version, it will not be supplied as argument."
                       TextWrapping="Wrap" Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4" />

            <TextBlock Text="Compression Method" FontWeight="SemiBold" Margin="0,0,0,2" />
            <CheckBox Content="-m0: Store (no compression). Files are stored as-is." IsChecked="{Binding SwitchM0}" Margin="0,1" />
            <CheckBox Content="-m1: Fastest compression. Lowest ratio, fastest speed." IsChecked="{Binding SwitchM1}" Margin="0,1" />
            <CheckBox Content="-m2: Fast compression." IsChecked="{Binding SwitchM2}" Margin="0,1" />
            <CheckBox Content="-m3: Normal compression (RAR default)." IsChecked="{Binding SwitchM3}" Margin="0,1" />
            <CheckBox Content="-m4: Good compression." IsChecked="{Binding SwitchM4}" Margin="0,1" />
            <CheckBox Content="-m5: Best compression. Highest ratio, slowest speed." IsChecked="{Binding SwitchM5}" Margin="0,1" />

            <TextBlock Text="Archive Format" FontWeight="SemiBold" Margin="0,4,0,2" />
            <CheckBox Content="-ma4: Force RAR 4.x archive format. Required for RAR 5.50+ to create RAR4 archives." IsChecked="{Binding SwitchMA4}" Margin="0,1" />
            <CheckBox Content="-ma5: Force RAR 5.0 archive format. Default for RAR 5.50+." IsChecked="{Binding SwitchMA5}" Margin="0,1" />

            <TextBlock Text="Dictionary Size" FontWeight="SemiBold" Margin="0,4,0,2" />
            <Grid HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- RAR4 & RAR5 compatible -->
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="RAR4 &amp; RAR5 compatible" Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,2" />
                <CheckBox Content="md64k - 64 KB" IsChecked="{Binding SwitchMD64K}" Margin="0,1" />
                <CheckBox Content="md128k - 128 KB" IsChecked="{Binding SwitchMD128K}" Margin="0,1" />
                <CheckBox Content="md256k - 256 KB" IsChecked="{Binding SwitchMD256K}" Margin="0,1" />
                <CheckBox Content="md512k - 512 KB" IsChecked="{Binding SwitchMD512K}" Margin="0,1" />
                <CheckBox Content="md1024k - 1024 KB (1 MB)" IsChecked="{Binding SwitchMD1024K}" Margin="0,1" />
                <CheckBox Content="md2048k - 2048 KB (2 MB)" IsChecked="{Binding SwitchMD2048K}" Margin="0,1" />
                <CheckBox Content="md4096k - 4096 KB (4 MB, max RAR4)" IsChecked="{Binding SwitchMD4096K}" Margin="0,1" />
              </StackPanel>

              <!-- RAR5 only -->
              <StackPanel Grid.Column="1">
                <TextBlock Text="RAR5 only (8 MB – 1 GB)" Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,2" />
                <CheckBox Content="md8m - 8 MB" IsChecked="{Binding SwitchMD8M}" Margin="0,1" />
                <CheckBox Content="md16m - 16 MB" IsChecked="{Binding SwitchMD16M}" Margin="0,1" />
                <CheckBox Content="md32m - 32 MB" IsChecked="{Binding SwitchMD32M}" Margin="0,1" />
                <CheckBox Content="md64m - 64 MB" IsChecked="{Binding SwitchMD64M}" Margin="0,1" />
                <CheckBox Content="md128m - 128 MB" IsChecked="{Binding SwitchMD128M}" Margin="0,1" />
                <CheckBox Content="md256m - 256 MB" IsChecked="{Binding SwitchMD256M}" Margin="0,1" />
                <CheckBox Content="md512m - 512 MB" IsChecked="{Binding SwitchMD512M}" Margin="0,1" />
                <CheckBox Content="md1g - 1 GB" IsChecked="{Binding SwitchMD1G}" Margin="0,1" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Timestamps -->
      <TabItem Header="Timestamps">
        <ScrollViewer VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False">
          <Grid HorizontalAlignment="Left" Margin="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Modification Time -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
              <TextBlock Text="Modification Time (-tsm)" FontWeight="SemiBold" Margin="0,0,0,2" />
              <CheckBox Content="tsm0 - Not saved (3.20+)" IsChecked="{Binding SwitchTSM0}" Margin="0,1" />
              <CheckBox Content="tsm1 - 1s precision (DOS)" IsChecked="{Binding SwitchTSM1}" Margin="0,1" />
              <CheckBox Content="tsm2 - 0.0065536s precision" IsChecked="{Binding SwitchTSM2}" Margin="0,1" />
              <CheckBox Content="tsm3 - 0.0000256s precision" IsChecked="{Binding SwitchTSM3}" Margin="0,1" />
              <CheckBox Content="tsm4 - Max NTFS precision" IsChecked="{Binding SwitchTSM4}" Margin="0,1" />
            </StackPanel>

            <!-- Creation Time -->
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="Creation Time (-tsc)" FontWeight="SemiBold" Margin="0,0,0,2" />
              <CheckBox Content="tsc0 - Not saved" IsChecked="{Binding SwitchTSC0}" Margin="0,1" />
              <CheckBox Content="tsc1 - 1s precision" IsChecked="{Binding SwitchTSC1}" Margin="0,1" />
              <CheckBox Content="tsc2 - 0.0065536s precision" IsChecked="{Binding SwitchTSC2}" Margin="0,1" />
              <CheckBox Content="tsc3 - 0.0000256s precision" IsChecked="{Binding SwitchTSC3}" Margin="0,1" />
              <CheckBox Content="tsc4 - Max NTFS precision" IsChecked="{Binding SwitchTSC4}" Margin="0,1" />
            </StackPanel>

            <!-- Access Time -->
            <StackPanel Grid.Column="2">
              <TextBlock Text="Access Time (-tsa)" FontWeight="SemiBold" Margin="0,0,0,2" />
              <CheckBox Content="tsa0 - Not saved" IsChecked="{Binding SwitchTSA0}" Margin="0,1" />
              <CheckBox Content="tsa1 - 1s precision" IsChecked="{Binding SwitchTSA1}" Margin="0,1" />
              <CheckBox Content="tsa2 - 0.0065536s precision" IsChecked="{Binding SwitchTSA2}" Margin="0,1" />
              <CheckBox Content="tsa3 - 0.0000256s precision" IsChecked="{Binding SwitchTSA3}" Margin="0,1" />
              <CheckBox Content="tsa4 - Max NTFS precision" IsChecked="{Binding SwitchTSA4}" Margin="0,1" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- Options -->
      <TabItem Header="Options">
        <ScrollViewer VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False">
          <StackPanel Margin="4">
            <CheckBox Content="-ai: Ignore file attributes. Mutually exclusive with A/I attribute testing." IsChecked="{Binding SwitchAI}"
                      IsEnabled="{Binding IsSwitchAIEnabled}" Margin="0,1" />
            <CheckBox Content="-r: Recurse subdirectories." IsChecked="{Binding SwitchR}" Margin="0,1" />
            <CheckBox Content="-ds: Disable name sort. Files are added in filesystem order." IsChecked="{Binding SwitchDS}" Margin="0,1" />
            <CheckBox Content="-s: Solid archiving." IsChecked="{Binding SwitchS}" Margin="0,1" />
            <CheckBox Content="-s-: Disable solid archiving." IsChecked="{Binding SwitchSDash}" Margin="0,1" />

            <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

            <CheckBox IsChecked="{Binding SwitchMT}" Margin="0,1">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="-mt: Number of CPU threads to use for compression." VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <!-- "Thread count from/to", NOT "Thread count range start/end": each box's visible
                     label is the "From:"/"To:" beside it, and WCAG 2.5.3 (Label in Name) requires
                     the accessible name to CONTAIN that visible text so a speech-input user can
                     activate what they can see. "…range start" does not contain "From". LabeledBy
                     on the caption would satisfy 2.5.3 but announce a bare "From:", which says
                     nothing about what it is from — the explicit name carries both. -->
                <TextBox Text="{Binding SwitchMTStart}" Width="70" Margin="0,0,8,0"
                         AutomationProperties.Name="Thread count from"
                         IsEnabled="{Binding IsMTRangeEnabled}" />
                <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Text="{Binding SwitchMTEnd}" Width="70" Margin="0,0,4,0"
                         AutomationProperties.Name="Thread count to"
                         IsEnabled="{Binding IsMTRangeEnabled}" />
                <TextBlock Text="(inclusive)" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
              </StackPanel>
            </CheckBox>
            <TextBlock Text="Changing the thread count slightly affects compression ratio. Archives created with different -mt values will not be identical even if all other settings are equal."
                       TextWrapping="Wrap" Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,2" />

            <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

            <CheckBox IsChecked="{Binding SwitchV}" Margin="0,1">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="-v: Create multi-volume archives with specified volume size." VerticalAlignment="Center" Margin="0,0,4,0" />
                <!-- Neither of these has a visible label of its OWN (the sentence to their left is
                     the CheckBox's own content, i.e. that checkbox's label), so 2.5.3 does not
                     constrain the wording here the way it does the -mt pair above. -->
                <TextBox Text="{Binding VolumeSize}" Width="100"
                         AutomationProperties.Name="Volume size"
                         IsEnabled="{Binding IsVolumeOptionsEnabled}" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{x:Static vm:ReconstructorViewModel.VolumeSizeUnits}"
                          SelectedIndex="{Binding VolumeSizeUnitIndex}"
                          Width="80"
                          AutomationProperties.Name="Volume size unit"
                          IsEnabled="{Binding IsVolumeOptionsEnabled}" />
              </StackPanel>
            </CheckBox>
            <CheckBox Content="-vn: Use old-style volume naming (.rar, .r00, .r01) instead of (.part1.rar, .part2.rar)."
                      IsChecked="{Binding UseOldVolumeNaming}"
                      IsEnabled="{Binding IsVolumeOptionsEnabled}" Margin="0,1" />

            <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

            <TextBlock Text="File Attributes" FontWeight="SemiBold" />
            <TextBlock Text="Set the given attribute(s) on the files before archiving. This does not affect directories."
                       TextWrapping="Wrap" Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,2" />
            <CheckBox Content="A - Set archive file attribute (attrib +A)." IsChecked="{Binding FileA}" IsThreeState="True"
                      IsEnabled="{Binding IsFileAttributesEnabled}" Margin="0,1" />
            <CheckBox Content="I - Set not content indexed attribute on each file before compressing." IsChecked="{Binding FileI}" IsThreeState="True"
                      IsEnabled="{Binding IsFileAttributesEnabled}" Margin="0,1" />
            <!-- Tri-state legend: three permanently-disabled sample checkboxes, each next to the
                 caption that says what that glyph state means. They are decorative — nothing here
                 is settable — so the ideal treatment would be to drop them out of the control
                 view entirely. That is NOT available: AutomationProperties.AccessibilityView="Raw"
                 was MEASURED on this Avalonia (11.3.18) to leave the peer in its parent's
                 GetChildren() walk unchanged, i.e. it is a no-op here — the same finding
                 StylesTests' HelpDisclosure_ExposesCoherentAutomationPeers_InBothModes already
                 records for the Expander toggle. Shipping it would have been a comment claiming an
                 effect the code does not have.
                 So they are LABELLED instead, by the very caption that explains them: the caption
                 is genuinely this checkbox's label, LabeledBy keeps the visible text the single
                 source of it (2.5.3 holds trivially), and it closes the 4.1.2 gap the gate found
                 ("announce as unnamed disabled") with a mechanism that demonstrably works. -->
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                <CheckBox IsEnabled="False" IsChecked="False" Padding="0" MinWidth="0"
                          AutomationProperties.LabeledBy="{Binding #LegendNeverCaption}" />
                <TextBlock x:Name="LegendNeverCaption" Text="Option is never set" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" Margin="4,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                <CheckBox IsEnabled="False" IsChecked="True" Padding="0" MinWidth="0"
                          AutomationProperties.LabeledBy="{Binding #LegendBothCaption}" />
                <TextBlock x:Name="LegendBothCaption" Text="Test with and without this option set" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" Margin="4,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <CheckBox IsEnabled="False" IsChecked="{x:Null}" IsThreeState="True" Padding="0" MinWidth="0"
                          AutomationProperties.LabeledBy="{Binding #LegendAlwaysCaption}" />
                <TextBlock x:Name="LegendAlwaysCaption" Text="Option is always set" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" Margin="4,0,0,0" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Output -->
      <TabItem Header="Output">
        <ScrollViewer VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False">
          <StackPanel Margin="4">
            <CheckBox Content="Delete non-matching RAR files after testing. Saves disk space during brute force."
                      IsChecked="{Binding DeleteRARFiles}" Margin="0,1" />
            <CheckBox Content="Delete RAR files with duplicate CRC32 values. Only available when not deleting all non-matching files."
                      IsChecked="{Binding DeleteDuplicateCRCFiles}"
                      IsEnabled="{Binding IsDeleteDuplicateCRCEnabled}" Margin="0,1" />
            <CheckBox Content="Stop after the first match — don't keep testing other settings."
                      IsChecked="{Binding StopOnFirstMatch}" Margin="0,1" />
            <StackPanel Margin="20,0,0,0">
              <CheckBox Content="Rename rebuilt archives to the release's original filenames (from the SRR, or the verification .sfv)."
                        IsChecked="{Binding RenameToReleaseNames}"
                        IsEnabled="{Binding IsRenameEnabled}" Margin="0,1" />
            </StackPanel>
            <CheckBox Content="Recreate the whole release (write every volume)."
                      IsChecked="{Binding CompleteAllVolumes}" Margin="0,1" />
            <CheckBox Content="Patch brute-forced RAR headers to match the original archive (Host OS, attributes, LARGE flag, mtime)."
                      IsChecked="{Binding EnableHostOSPatching}" Margin="0,1" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <!-- ── Resizable splitter ─────────────────────────────────
         Background moves to the Styles.axaml base + :focus styles (so :focus can win); see the
         checkbox-glyph comment for why a plain local value there would have shadowed it. -->
    <GridSplitter Grid.Row="5"
                  Height="{DynamicResource SplitterHeight}"
                  HorizontalAlignment="Stretch"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  AutomationProperties.Name="Resize options and log" />

    <!-- ── Log (bottom panel) ───────────────────────────────────
         One chronological log (LogEntries) replacing the WPF-era System/Phase 1/Phase 2 tabs — the
         split hid Phase-2 failures from anyone parked on the System tab. Engine phase lines carry
         [P1]/[P2] tags (legend logged at run start). The virtualized logList ListBox is the app-wide
         log pattern; the Auto-scroll checkbox binds the style's stick-to-bottom behavior directly
         (local value over the style's default True), replacing the old caret-to-end code-behind.
         The header names the list via LabeledBy (4.1.2). -->
    <DockPanel Grid.Row="6">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
        <Button DockPanel.Dock="Right" Content="Save log..."
                Command="{Binding SaveLogCommand}"
                Classes="ghost"
                Padding="8,2" />
        <CheckBox DockPanel.Dock="Right"
                  Content="Auto-scroll"
                  IsChecked="{Binding AutoScrollLog}"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0" />
        <TextBlock x:Name="LogHeader" DockPanel.Dock="Left" Text="Log" FontWeight="SemiBold" VerticalAlignment="Center" />
        <!-- THREE live status presenters share ONE fixed-proportion Grid, exactly as
             SRSReconstructorView pairs its own ResultStatus with SaveLogStatus, and for the same
             two reasons recorded there: several same-direction docked TextBlocks leave DockPanel's
             remaining-rect bookkeeping unpredictable under long text, and Star columns never
             re-derive their width from a child's DesiredSize, so the split cannot silently starve
             one of them to zero. Equal thirds rather than SRSReconstructor's 1*/2*: none of the
             three is the obvious primary here, and all three trim. The trade-off is the same one
             accepted there — a guaranteed non-zero floor for each beats an adaptive split that can
             render one invisible.
             All three are ALWAYS in the tree with LiveSetting=Polite and no
             AutomationProperties.Name (the announced name IS the text): an IsVisible-toggled
             element is not realized when its text arrives, so the transition an AT listens for
             never happens. That is precisely why the custom-packer BORDER above announces nothing
             and is left announcement-free — it toggles IsVisible — and why its text is mirrored
             here instead. Empty text renders nothing, so the row looks identical when idle. -->
        <Grid ColumnDefinitions="1*,1*,1*">
          <TextBlock Grid.Column="0" x:Name="CustomPackerStatus" Text="{Binding CustomPackerWarning}"
                     AutomationProperties.LiveSetting="Polite"
                     Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
          <!-- Import/Export Config previously reported only into the log list, which is
               deliberately NOT a live region — so both outcomes were silent (gate finding (d)). -->
          <TextBlock Grid.Column="1" x:Name="ConfigStatus" Text="{Binding ConfigAnnouncement}"
                     AutomationProperties.LiveSetting="Polite"
                     Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
          <!-- Live save-outcome line (4.1.3): always in the tree — visibility-toggling would race
               the announcement; empty text renders nothing. No AutomationProperties.Name: the
               announced name IS the text. -->
          <TextBlock Grid.Column="2" x:Name="SaveLogStatus" Text="{Binding SaveLogAnnouncement}"
                     AutomationProperties.LiveSetting="Polite"
                     Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
        </Grid>
      </DockPanel>
      <ListBox x:Name="RunLogList"
               ItemsSource="{Binding LogEntries}"
               Classes="logList"
               behaviors:ListBoxAutoScroll.AutoScrollToEnd="{Binding AutoScrollLog}"
               AutomationProperties.LabeledBy="{Binding #LogHeader}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               FontFamily="{DynamicResource MonoFontFamily}"
               FontSize="{DynamicResource MonoFontSize}" />
    </DockPanel>

  </Grid>

</UserControl>
