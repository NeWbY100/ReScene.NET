<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ReScene.Manager.Controls"
             xmlns:behaviors="clr-namespace:ReScene.Manager.Behaviors"
             x:Class="ReScene.Manager.Views.SRSCreatorView"
             x:CompileBindings="False">

  <Grid Margin="{DynamicResource PageMargin}" x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />                 <!-- 0: Help -->
      <RowDefinition Height="Auto" />                 <!-- 1: config (AutoToStar) -->
      <RowDefinition Height="Auto" />                 <!-- 2: pinned action band -->
      <RowDefinition Height="*" MinHeight="80" />     <!-- 3: log band -->
    </Grid.RowDefinitions>

    <!-- ── Help ── A flat, always-visible section: one body scroller, no disclosure. It was an
         Expander until compact mode's habit of force-collapsing it made whichever view went
         compact first look like the only tab that hid its help behind a dropdown. Compact mode
         still bounds the body via CompactHeightBehavior.HelpBodyMaxHeight, set in the code-behind.
         Margin is NOT a local value (house rule: local values beat unconditional styles, so a
         local "0,0,0,6" would defeat the compact-mode margin tightening) — it lives in the
         helpSection style. -->
    <ScrollViewer Grid.Row="0" x:Name="HelpBody" Classes="helpSection helpBody"
                  VerticalScrollBarVisibility="Auto"
                  ScrollViewer.AllowAutoHide="False">
      <TextBlock Margin="0,0,4,0"
                 Text="Create an SRS (Sample Rescue Storage) file from a sample video file. The SRS stores enough data to reconstruct the exact sample from any copy of the same video."
                 Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                 TextWrapping="Wrap" />
    </ScrollViewer>

    <!-- ── Config band (always-present; squeezes + scrolls in compact via AutoToStar) ──
         Content renders at natural height at normal size (row is Auto), no scrollbar shown. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  ScrollViewer.AllowAutoHide="False">
      <StackPanel Margin="0,0,4,0">

        <!-- ── Sample File ─────────────────────────────────────────── -->
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
          <Run Text="Sample File " FontWeight="SemiBold" />
          <Run Text="— The small sample clip (.mkv, .avi, .mp4, …) to store. Usually in a Sample/ subfolder of the release."
               Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
        </TextBlock>
        <DockPanel KeyboardNavigation.TabNavigation="Local">
          <!-- "Browse for <target>", target from this row's own visible caption subject — see
               SampleRestorerView's first Browse button for the convention and the WCAG 2.5.3
               reasoning that makes it safe here (Content is the bare word "Browse"). -->
          <Button DockPanel.Dock="Right" Content="Browse"
                  Command="{Binding BrowseInputCommand}" TabIndex="2"
                  Classes="ghost"
                  AutomationProperties.Name="Browse for sample file"
                  Margin="4,0,0,0" MinWidth="75" />
          <TextBox x:Name="InputTextBox" Text="{Binding InputPath}" TabIndex="0"
                   AutomationProperties.Name="Sample file path"
                   behaviors:TextBoxDropBehavior.DropMode="File" />
        </DockPanel>
        <controls:FieldStatusLine Status="{Binding SampleStatus}" />

        <!-- ── ISO file selection (visible only when ISO loaded, single mode) ── -->
        <DockPanel IsVisible="{Binding ShowISOSelection}"
                   Margin="0,4,0,0">
          <TextBlock x:Name="ISOFileCaption" Text="File inside ISO:" VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <!-- LabeledBy, not an explicit Name: this caption is a short standalone label rather than
               the subject+prose sentences the picker rows above carry, so the caption IS this
               control's name and pointing at it keeps the visible text the single source of it
               (WCAG 2.5.3 holds by construction). Avalonia 11.3.18 has no
               AutomationProperties.DescribedBy (MEASURED), so LabeledBy is the association channel
               available wherever the caption genuinely is the label. -->
          <ComboBox ItemsSource="{Binding ISOMediaFiles}"
                    SelectedItem="{Binding SelectedISOMediaFile}"
                    AutomationProperties.LabeledBy="{Binding #ISOFileCaption}"
                    FontFamily="{DynamicResource MonoFontFamily}"
                    FontSize="{DynamicResource FontSizeCaption}" />
        </DockPanel>

        <!-- separator -->
        <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

        <!-- ── Main file (optional, for MatchOffset verification) ──────── -->
        <TextBlock Margin="0,0,0,2">
          <Run Text="Main file " FontWeight="SemiBold" />
          <Run Text="(optional — populates MatchOffset, matches pyrescene's -c flag)"
               Foreground="{DynamicResource ForegroundSecondary}"
               FontSize="{DynamicResource FontSizeCaption}" />
        </TextBlock>
        <DockPanel KeyboardNavigation.TabNavigation="Local">
          <Button DockPanel.Dock="Right" Content="Browse"
                  Command="{Binding BrowseMainFileCommand}" TabIndex="2"
                  Classes="ghost"
                  AutomationProperties.Name="Browse for main file"
                  Margin="4,0,0,0" MinWidth="75" />
          <Button DockPanel.Dock="Right" Content="Clear"
                  Command="{Binding ClearMainFileCommand}"
                  Classes="ghost"
                  TabIndex="1"
                  Margin="4,0,0,0" MinWidth="60" />
          <!-- "<subject> path", subject taken from this row's own visible caption ("Main file"),
               matching InputTextBox above and CreatorView's own Input/Output boxes. -->
          <TextBox Text="{Binding MainFilePath}"
                   TabIndex="0"
                   AutomationProperties.Name="Main file path" />
        </DockPanel>
        <controls:FieldStatusLine Status="{Binding MainFileStatus}" Margin="0,2,0,0" />

        <!-- separator -->
        <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

        <!-- ── Output ────────────────────────────────────────────── -->
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
          <Run Text="Output " FontWeight="SemiBold" />
          <Run Text="— Where the .srs file will be written."
               Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
        </TextBlock>
        <DockPanel KeyboardNavigation.TabNavigation="Local">
          <!-- "Browse for output path" VERBATIM from CreatorView, the Create-SRR wizard and
               SRSReconstructorView: four surfaces, one function (choose where the output file is
               written), so one name (WCAG 3.2.4). The Reconstructor's own output picker reads
               "Browse for output folder" instead, and that is not an inconsistency — it picks a
               DIRECTORY, which is a different thing to choose. -->
          <Button DockPanel.Dock="Right" Content="Browse"
                  Command="{Binding BrowseOutputCommand}" TabIndex="2"
                  Classes="ghost"
                  AutomationProperties.Name="Browse for output path"
                  Margin="4,0,0,0" MinWidth="75" />
          <TextBox x:Name="OutputTextBox" Text="{Binding OutputPath}" TabIndex="0"
                   AutomationProperties.Name="Output path"
                   behaviors:TextBoxDropBehavior.DropMode="File" />
        </DockPanel>
        <controls:FieldStatusLine Status="{Binding OutputStatus}" />

        <!-- separator -->
        <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

        <!-- ── Options ───────────────────────────────────────────── -->
        <TextBlock Text="Options" FontWeight="SemiBold" Margin="0,0,0,2" />
        <DockPanel Margin="0,0,0,2">
          <TextBlock x:Name="AppNameCaption" Text="App name:" VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <!-- LabeledBy the short caption beside it — see the ISO ComboBox above for the rule. -->
          <TextBox Text="{Binding AppName}" Width="400"
                   AutomationProperties.LabeledBy="{Binding #AppNameCaption}"
                   HorizontalAlignment="Left" />
          <TextBlock Text="Embedded in the SRS file to identify the creating application."
                     VerticalAlignment="Center" Margin="8,0,0,0"
                     Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
        </DockPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- ── Pinned action band — ALWAYS visible (this row
         previously clipped off-screen mid-run). Overlay/adorner implementations forbidden. The two
         separators bracketing it are the SAME two pre-existing Border elements from today's
         markup (the one that used to sit right before the action row, and the one that used to
         sit right before the log) — relocated together, not duplicated. ── -->
    <StackPanel Grid.Row="2">
      <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

      <!-- ── Action row ────────────────────────────────────────── -->
      <DockPanel Margin="0,0,0,2">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Create SRS"
                  Command="{Binding CreateSRSCommand}"
                  Classes="primary"
                  Padding="16,4" Margin="0,0,4,0" />
          <Button Content="Cancel"
                  Command="{Binding CancelCreationCommand}"
                  Classes="cancel"
                  IsVisible="{Binding IsCreating}"
                  Padding="16,4" />
        </StackPanel>
        <TextBlock Text="{Binding ProgressMessage}"
                   IsVisible="{Binding ShowProgress}"
                   VerticalAlignment="Center" />
      </DockPanel>

      <!-- Progress bar -->
      <ProgressBar Value="{Binding ProgressPercent}"
                   Maximum="100" Height="18"
                   Margin="0,0,0,4"
                   IsVisible="{Binding ShowProgress}" />

      <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />
    </StackPanel>

    <!-- ── Log (fills remaining space) ───────────────────────── -->
    <DockPanel Grid.Row="3">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
        <Button DockPanel.Dock="Right" Content="Save log..."
                Command="{Binding SaveLogCommand}"
                Classes="ghost"
                Padding="8,2" />
        <TextBlock x:Name="LogHeader" DockPanel.Dock="Left" Text="Log" FontWeight="SemiBold" VerticalAlignment="Center" />
        <!-- Live save-outcome line (4.1.3): always in the tree — visibility-toggling would race
             the announcement; empty text renders nothing. No AutomationProperties.Name: the
             announced name IS the text. -->
        <TextBlock x:Name="SaveLogStatus" Text="{Binding SaveLogAnnouncement}"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
      </DockPanel>
      <ListBox ItemsSource="{Binding LogEntries}"
               Classes="logList"
               AutomationProperties.LabeledBy="{Binding #LogHeader}"
               FontFamily="{DynamicResource MonoFontFamily}"
               FontSize="{DynamicResource MonoFontSize}" />
    </DockPanel>

  </Grid>

</UserControl>
