<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ReScene.Manager.Controls"
             xmlns:sys="using:System"
             x:Class="ReScene.Manager.Views.InspectorView"
             x:CompileBindings="False"
             x:Name="InspectorRoot">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{Binding ShowHexSearchCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding HideHexSearchCommand}" />
    <KeyBinding Gesture="F3" Command="{Binding FindNextCommand}" />
    <KeyBinding Gesture="Shift+F3" Command="{Binding FindPreviousCommand}" />
  </UserControl.KeyBindings>

  <!-- Properties-grid density, scoped to this view so other grids are untouched. Fluent's DataGridCell
       theme defaults to a roomy 32px MinHeight and paints a white per-cell focus rectangle
       (DataGridCellFocusVisualPrimaryBrush) on the clicked cell; the WPF Inspector had neither. Restore
       the compact single-row-selection look: shrink the cell floor and keep the theme's :focus
       FocusVisual hidden (the selected-row highlight is the focus indicator here). -->
  <UserControl.Styles>
    <Style Selector="DataGridCell">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <!-- ── Inspector panels ──────────────────────────────────── -->
  <DockPanel Margin="{DynamicResource PageMargin}">
    <TextBlock DockPanel.Dock="Top"
               Text="Inspect the internal structure of SRR, SRS, and RAR files. Browse blocks in the tree, view properties for each block, and examine raw hex data."
               Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
               TextWrapping="Wrap" Margin="0,0,0,6" />

    <!-- File selection bar -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
      <!-- The File caption shares its row with this view's two live regions, so neither costs any
           layout: the row is measured by the caption, and both status texts are trimmed to one line
           rather than wrapped. They sit in a fixed 1*/1* Grid rather than each being separately
           docked, because two same-direction docked TextBlocks left DockPanel's arrange bookkeeping
           unpredictable under long text in both — the failure SRSReconstructorView's own log-header
           comment records, and its 1*/2* split is the precedent for this shape.
           Both of the things they announce are IsVisible-toggled panels that cannot announce
           themselves: the custom-packer warning bar below, and the Integrity Verify Result panel.
           Neither ViewModel needed a re-arm added here — LoadFile already clears WarningMessage
           before it can be set again, and VerifyIntegrityAsync now clears VerifyAnnouncement first
           for the same reason. -->
      <DockPanel Margin="0,0,0,2">
        <TextBlock DockPanel.Dock="Left" Text="File" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Grid ColumnDefinitions="1*,1*" Margin="8,0,0,0">
          <TextBlock x:Name="WarningStatus" Grid.Column="0"
                     Text="{Binding WarningMessage}"
                     AutomationProperties.LiveSetting="Polite"
                     Foreground="{DynamicResource ForegroundSecondary}"
                     FontSize="{DynamicResource FontSizeCaption}"
                     TextTrimming="CharacterEllipsis"
                     TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock x:Name="VerifyStatus" Grid.Column="1"
                     Text="{Binding VerifyAnnouncement}"
                     AutomationProperties.LiveSetting="Polite"
                     Foreground="{DynamicResource ForegroundSecondary}"
                     FontSize="{DynamicResource FontSizeCaption}"
                     TextTrimming="CharacterEllipsis"
                     TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </DockPanel>
      <DockPanel KeyboardNavigation.TabNavigation="Local">
        <Button DockPanel.Dock="Right" Content="Close"
                Command="{Binding CloseFileCommand}"
                Classes="ghost"
                TabIndex="2"
                Margin="4,0,0,0" MinWidth="55" />
        <!-- The row's caption is the single word "File", which would make an uninformative name
             app-wide, so the view's own purpose supplies the qualifier. Safe under WCAG 2.5.3:
             the visible label is the bare word "Browse", which the name contains. -->
        <Button DockPanel.Dock="Right" Content="Browse"
                Command="{Binding BrowseFileCommand}"
                Classes="ghost"
                AutomationProperties.Name="Browse for file to inspect"
                TabIndex="1"
                Margin="4,0,0,0" MinWidth="75" />
        <!-- Editable: type or paste a path and press Enter to load (no dialog needed). -->
        <TextBox x:Name="LoadedFilePathTextBox"
                 Text="{Binding LoadedFilePath}"
                 PlaceholderText="Type a path and press Enter, or Browse"
                 TabIndex="0"
                 FontSize="{DynamicResource FontSizeBody}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding LoadFromPathCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
      </DockPanel>
    </StackPanel>

    <!-- Warning bar for custom packer detection -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasWarning}"
            Background="{DynamicResource WarningBannerBackground}"
            BorderBrush="{DynamicResource WarningBannerBorder}" BorderThickness="1"
            CornerRadius="3" Margin="0,0,0,4" Padding="8,5">
      <TextBlock Text="{Binding WarningMessage}"
                 Foreground="{DynamicResource WarningForeground}"
                 FontSize="{DynamicResource FontSizeBody}"
                 TextWrapping="Wrap" />
    </Border>

    <Grid ColumnDefinitions="400,Auto,*">

      <!-- Left panel: Structure -->
      <Border Grid.Column="0"
              Classes="section"
              Margin="2,2,0,2">
        <DockPanel>
          <!-- Panel header -->
          <Border DockPanel.Dock="Top" Classes="panelHeaderBar">
            <TextBlock Classes="panelHeader" Text="Structure" />
          </Border>

          <!-- Filter box -->
          <TextBox DockPanel.Dock="Top"
                   Text="{Binding TreeFilterText}"
                   Margin="{DynamicResource TreeFilterMargin}" />

          <TreeView x:Name="StructureTree"
                    ItemsSource="{Binding TreeRoots}"
                    SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}"
                    DoubleTapped="OnTreeDoubleTapped"
                    Margin="{DynamicResource TreeViewMargin}"
                    FontSize="{DynamicResource FontSizeBody}">
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsVisible" Value="{Binding IsVisible}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Text}"
                           TextTrimming="CharacterEllipsis" />
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Export..."
                          Command="{Binding ExportBlockCommand}" />
                <Separator IsVisible="{Binding IsSRRLoaded}" />
                <MenuItem Header="Add Stored File..."
                          Command="{Binding AddStoredFileToSRRCommand}"
                          IsVisible="{Binding IsSRRLoaded}" />
                <MenuItem Header="Remove Stored File"
                          Command="{Binding RemoveStoredFileFromSRRCommand}"
                          IsVisible="{Binding IsStoredFileSelected}" />
                <Separator IsVisible="{Binding IsStoredFileSelected}" />
                <MenuItem Header="Rename..."
                          Command="{Binding RenameStoredFileCommand}"
                          IsVisible="{Binding IsStoredFileSelected}" />
                <MenuItem Header="Move Up"
                          Command="{Binding MoveStoredFileUpCommand}"
                          IsVisible="{Binding IsStoredFileSelected}" />
                <MenuItem Header="Move Down"
                          Command="{Binding MoveStoredFileDownCommand}"
                          IsVisible="{Binding IsStoredFileSelected}" />
                <Separator IsVisible="{Binding IsSRRLoaded}" />
                <MenuItem Header="Verify integrity"
                          Command="{Binding VerifyIntegrityCommand}"
                          IsVisible="{Binding IsSRRLoaded}" />
                <Separator />
                <MenuItem Header="Export properties as JSON..."
                          Command="{Binding ExportSelectedPropertiesCommand}" />
                <MenuItem Header="Export entire tree as JSON..."
                          Command="{Binding ExportTreeCommand}" />
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
        </DockPanel>
      </Border>

      <!-- Splitter -->
      <GridSplitter Grid.Column="1"
                    Width="{DynamicResource SplitterWidth}"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext" />

      <!-- Right panel: Verify Result + Properties + Hex -->
      <Grid Grid.Column="2"
            Margin="0,2,2,2"
            RowDefinitions="Auto,*,Auto,*">

        <!-- Verify result panel -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsVerifyResultVisible}"
                Classes="section"
                Margin="0,0,0,4">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="panelHeaderBar">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close"
                        Command="{Binding DismissVerifyResultCommand}"
                        Classes="ghost"
                        MinWidth="55" Margin="4,0,0,0" />
                <TextBlock Classes="panelHeader" Text="Integrity Verify Result" />
              </DockPanel>
            </Border>
            <TextBox Text="{Binding VerifyResultText, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     FontFamily="{DynamicResource MonoFontFamily}"
                     FontSize="{DynamicResource FontSizeCaption}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     MaxHeight="180"
                     Padding="6"
                     BorderThickness="0" />
          </DockPanel>
        </Border>

        <!-- Properties panel -->
        <Border Grid.Row="1" Classes="section">
          <DockPanel>
            <!-- Panel header -->
            <Border DockPanel.Dock="Top" Classes="panelHeaderBar">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="View Image"
                        Command="{Binding PreviewStoredImageCommand}"
                        Classes="ghost"
                        MinWidth="80" Margin="4,0,0,0"
                        IsVisible="{Binding IsImagePreviewAvailable}" />
                <TextBlock Classes="panelHeader" Text="Properties" />
              </DockPanel>
            </Border>

            <Grid>
              <!-- DataGrid -->
              <DataGrid x:Name="PropertiesGrid"
                        ItemsSource="{Binding Properties}"
                        SelectedItem="{Binding SelectedProperty}"
                        IsReadOnly="True"
                        CanUserResizeColumns="True"
                        CanUserReorderColumns="False"
                        CanUserSortColumns="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        SelectionMode="Single"
                        BorderThickness="0"
                        Foreground="{DynamicResource ForegroundPrimary}"
                        AutoGenerateColumns="False">
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy Name"
                              Click="OnCopyPropertyNameClick" />
                    <MenuItem Header="Copy Value"
                              Click="OnCopyPropertyValueClick" />
                    <Separator />
                    <MenuItem Header="Copy Name: Value"
                              Click="OnCopyPropertyClick" />
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Property" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Margin="{Binding IsIndented, Converter={StaticResource IndentToMarginConverter}}"
                                   Foreground="{Binding IsIndented, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=SystemControlForegroundBaseMediumBrush|ForegroundPrimary}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Value" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Value}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{Binding IsWarning, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=WarningForeground|ForegroundPrimary}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>

              <!-- Empty state overlay -->
              <TextBlock Text="Select a tree node to view properties"
                         IsVisible="{Binding HasProperties, Converter={StaticResource InverseBoolConverter}}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="{DynamicResource EmptyStateFontSize}"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                         IsHitTestVisible="False" />
            </Grid>
          </DockPanel>
        </Border>

        <!-- Splitter between properties and hex -->
        <GridSplitter Grid.Row="2"
                      Height="{DynamicResource SplitterHeight}"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext" />

        <!-- Hex / Text view panel -->
        <Border Grid.Row="3"
                Classes="section">
          <Grid>
          <TabControl>
            <!-- Hex tab -->
            <TabItem Header="Hex" IsSelected="{Binding IsHexViewActive, Mode=OneWay}">
              <DockPanel>
                <!-- Bytes/Row toolbar lives on the tab-strip row now; see the Panel overlay below. -->
                <!-- Search bar -->
                <Border DockPanel.Dock="Top"
                        IsVisible="{Binding IsHexSearchVisible}"
                        Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource BorderSeparator}"
                        BorderThickness="0,0,0,1"
                        Padding="4">
                  <DockPanel>
                    <!-- Dock="Right" stacks right-to-left in declaration order, so this reads
                         backwards: Close is rightmost, then Next, then Prev to its left. -->
                    <Button DockPanel.Dock="Right" Content="Close"
                            Command="{Binding HideHexSearchCommand}"
                            Classes="ghost"
                            MinWidth="55" Margin="4,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Next"
                            Command="{Binding FindNextCommand}"
                            Classes="primary"
                            MinWidth="55" Margin="4,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Prev"
                            Command="{Binding FindPreviousCommand}"
                            Classes="ghost"
                            MinWidth="55" Margin="4,0,0,0" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding HexSearchStatus}"
                               Foreground="{DynamicResource ForegroundSecondary}"
                               VerticalAlignment="Center"
                               Margin="8,0" />
                    <CheckBox DockPanel.Dock="Right" Content="Hex"
                              IsChecked="{Binding HexSearchAsHex}"
                              VerticalAlignment="Center"
                              Margin="4,0,0,0" />
                    <CheckBox DockPanel.Dock="Right" Content="Highlight all"
                              IsChecked="{Binding HighlightAllMatches}"
                              VerticalAlignment="Center"
                              Margin="4,0,0,0" />
                    <TextBox x:Name="HexSearchBox"
                             Text="{Binding HexSearchText}"
                             FontFamily="{DynamicResource MonoFontFamily}"
                             VerticalAlignment="Center">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding FindNextCommand}" />
                        <KeyBinding Gesture="Shift+Enter" Command="{Binding FindPreviousCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                  </DockPanel>
                </Border>

                <controls:HexView x:Name="HexViewer"
                                  DataSource="{Binding HexDataSource}"
                                  BlockOffset="{Binding HexBlockOffset}"
                                  BlockLength="{Binding HexBlockLength}"
                                  SelectionOffset="{Binding HexSelectionOffset}"
                                  SelectionLength="{Binding HexSelectionLength}"
                                  BytesPerLine="{Binding HexBytesPerLine}"
                                  HighlightRanges="{Binding HexMatchRanges}" />
              </DockPanel>
            </TabItem>

            <!-- Text tab -->
            <TabItem Header="Text" IsSelected="{Binding IsTextViewActive, Mode=TwoWay}">
              <DockPanel>
                <!-- Encoding + Word wrap toolbar lives on the tab-strip row now; see the Panel overlay. -->
                <!-- Truncation note -->
                <Border DockPanel.Dock="Bottom"
                        IsVisible="{Binding TextViewTruncated}"
                        Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource BorderSeparator}"
                        BorderThickness="0,1,0,0"
                        Padding="6,3">
                  <TextBlock Text="Large block — showing the first 1 MB as text."
                             Foreground="{DynamicResource ForegroundSecondary}"
                             FontSize="{DynamicResource FontSizeCaption}" />
                </Border>
                <TextBox Text="{Binding TextViewContent, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="{Binding TextWordWrap, Converter={StaticResource BoolToTextWrappingConverter}}"
                         FontFamily="{DynamicResource MonoFontFamily}"
                         FontSize="{DynamicResource FontSizeCaption}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         Padding="6"
                         BorderThickness="0" />
              </DockPanel>
            </TabItem>
          </TabControl>

          <!-- Bytes/Row and Encoding toolbars sit on the tab-strip row (right-aligned), overlaying the
               TabControl so they appear beside the Hex/Text tabs instead of below them. Only the active
               tab's toolbar is shown (IsHexViewActive is the computed inverse of IsTextViewActive). -->
          <Panel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,8,0">
            <StackPanel Orientation="Horizontal" IsVisible="{Binding IsHexViewActive}">
              <TextBlock Text="Bytes/Row:" VerticalAlignment="Center"
                         Foreground="{DynamicResource ForegroundSecondary}"
                         FontSize="{DynamicResource FontSizeCaption}"
                         Margin="0,0,4,0" />
              <!-- Preset bytes-per-row dropdown (Avalonia's ComboBox is not editable, so the WPF presets
                   are fixed choices). Int32 items so SelectedItem round-trips the int HexBytesPerLine. -->
              <ComboBox SelectedItem="{Binding HexBytesPerLine}"
                        Width="64" Padding="8,3"
                        FontSize="{DynamicResource FontSizeCaption}"
                        VerticalAlignment="Center">
                <sys:Int32>8</sys:Int32>
                <sys:Int32>16</sys:Int32>
                <sys:Int32>24</sys:Int32>
                <sys:Int32>32</sys:Int32>
                <sys:Int32>48</sys:Int32>
                <sys:Int32>64</sys:Int32>
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" IsVisible="{Binding IsTextViewActive}">
              <TextBlock Text="Encoding:" VerticalAlignment="Center"
                         Foreground="{DynamicResource ForegroundSecondary}"
                         FontSize="{DynamicResource FontSizeCaption}"
                         Margin="0,0,4,0" />
              <ComboBox ItemsSource="{Binding TextEncodings}"
                        SelectedItem="{Binding SelectedEncoding}"
                        Width="160" FontSize="{DynamicResource FontSizeCaption}"
                        VerticalAlignment="Center" Padding="4,1">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <CheckBox Content="Word wrap"
                        IsChecked="{Binding TextWordWrap}"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0" />
            </StackPanel>
          </Panel>
          </Grid>
        </Border>

      </Grid>
    </Grid>
  </DockPanel>

</UserControl>
