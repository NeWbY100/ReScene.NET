<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ReScene.Manager.Controls"
             xmlns:behaviors="clr-namespace:ReScene.Manager.Behaviors"
             xmlns:conv="clr-namespace:ReScene.Manager.Converters"
             x:Class="ReScene.Manager.Views.SRSReconstructorView"
             x:CompileBindings="False">

  <UserControl.Resources>
    <conv:ResultSuccessToBrushConverter x:Key="ResultSuccessToBrush" />
  </UserControl.Resources>

  <Grid Margin="{DynamicResource PageMargin}" x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />                 <!-- 0: Help -->
      <RowDefinition Height="Auto" />                 <!-- 1: config (AutoToStar) -->
      <RowDefinition Height="Auto" />                 <!-- 2: pinned action band -->
      <RowDefinition Height="*" MinHeight="80" />     <!-- 3: log band -->
    </Grid.RowDefinitions>

    <!-- ── Help ── A flat, always-visible section: one body scroller, no disclosure. It was an
         Expander until compact mode's habit of force-collapsing it made whichever view went
         compact first look like the only tab that hid its help behind a dropdown. Compact mode
         still bounds the body via CompactHeightBehavior.HelpBodyMaxHeight, set in the code-behind.
         Margin is NOT a local value (house rule: local values beat unconditional styles, so a
         local "0,0,0,6" would defeat the compact-mode margin tightening) — it lives in the
         helpSection style. -->
    <ScrollViewer Grid.Row="0" x:Name="HelpBody" Classes="helpSection helpBody"
                  VerticalScrollBarVisibility="Auto"
                  ScrollViewer.AllowAutoHide="False">
      <TextBlock Margin="0,0,4,0"
                 Text="Reconstruct a sample file from an SRS file and the original full media file. The reconstructed sample will be CRC-verified against the expected checksum."
                 Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                 TextWrapping="Wrap" />
    </ScrollViewer>

    <!-- ── Config band (always-present; squeezes + scrolls in compact via AutoToStar) ──
         Content renders at natural height at normal size (row is Auto), no scrollbar shown. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  ScrollViewer.AllowAutoHide="False">
      <StackPanel Margin="0,0,4,0">

        <!-- ── SRS File ────────────────────────────────────────── -->
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
          <Run Text="SRS File " FontWeight="SemiBold" />
          <Run Text="— The .srs file describing the sample to rebuild."
               Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
        </TextBlock>
        <DockPanel KeyboardNavigation.TabNavigation="Local">
          <!-- "Browse for <target>", target from this row's own visible caption subject — see
               SampleRestorerView's first Browse button for the convention and the WCAG 2.5.3
               reasoning that makes it safe here (Content is the bare word "Browse"). -->
          <Button DockPanel.Dock="Right" Content="Browse"
                  Command="{Binding BrowseSRSCommand}" TabIndex="2"
                  Classes="ghost"
                  AutomationProperties.Name="Browse for SRS file"
                  Margin="4,0,0,0" MinWidth="75" />
          <TextBox x:Name="SRSFileTextBox" Text="{Binding SRSFilePath}" TabIndex="0"
                   AutomationProperties.Name="SRS file path"
                   behaviors:TextBoxDropBehavior.DropMode="File" />
        </DockPanel>
        <controls:FieldStatusLine Status="{Binding SRSStatus}" />

        <!-- separator -->
        <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

        <!-- ── Media File ──────────────────────────────────────── -->
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
          <Run Text="Media File " FontWeight="SemiBold" />
          <Run Text="— The full original media file the sample was cut from."
               Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
        </TextBlock>
        <DockPanel KeyboardNavigation.TabNavigation="Local">
          <Button DockPanel.Dock="Right" Content="Browse"
                  Command="{Binding BrowseMediaCommand}" TabIndex="2"
                  Classes="ghost"
                  AutomationProperties.Name="Browse for media file"
                  Margin="4,0,0,0" MinWidth="75" />
          <!-- Same convention and reasoning as SRSFileTextBox above: a short "<subject> path"
               phrase whose subject is this row's OWN visible caption ("Media File"), so the
               accessible name contains the visible label (WCAG 2.5.3). -->
          <TextBox x:Name="MediaFileTextBox" Text="{Binding MediaFilePath}" TabIndex="0" IsReadOnly="{Binding IsISOSource}"
                   AutomationProperties.Name="Media file path"
                   behaviors:TextBoxDropBehavior.DropMode="File" />
        </DockPanel>
        <controls:FieldStatusLine Status="{Binding MediaStatus}" />

        <!-- separator -->
        <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

        <!-- ── Output ──────────────────────────────────────────── -->
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
          <Run Text="Output " FontWeight="SemiBold" />
          <Run Text="— Where the rebuilt sample will be written."
               Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
        </TextBlock>
        <DockPanel KeyboardNavigation.TabNavigation="Local">
          <!-- "Browse for output path" VERBATIM from CreatorView, SRSCreatorView and the
               Create-SRR wizard — one function, one name (WCAG 3.2.4). -->
          <Button DockPanel.Dock="Right" Content="Browse"
                  Command="{Binding BrowseOutputCommand}" TabIndex="2"
                  Classes="ghost"
                  AutomationProperties.Name="Browse for output path"
                  Margin="4,0,0,0" MinWidth="75" />
          <TextBox x:Name="OutputTextBox" Text="{Binding OutputPath}" TabIndex="0"
                   AutomationProperties.Name="Output path"
                   behaviors:TextBoxDropBehavior.DropMode="File" />
        </DockPanel>
        <controls:FieldStatusLine Status="{Binding OutputStatus}" />

      </StackPanel>
    </ScrollViewer>

    <!-- ── Pinned action band — ALWAYS visible (this row
         previously clipped off-screen mid-run). Overlay/adorner implementations forbidden. The two
         separators bracketing it are the SAME two pre-existing Border elements from today's
         markup (relocated together, not duplicated); Margin is NOT a local value on either —
         Classes="pinnedSeparator" supplies today's verbatim 0,4 at normal size with a
         measured compact-only tightening (see Styles.axaml). ── -->
    <StackPanel Grid.Row="2">
      <Border Classes="pinnedSeparator" Height="1" Background="{DynamicResource BorderSeparator}" />

      <!-- ── Action row ────────────────────────────────────────── Margin is NOT a local
           value (same reason as the Expander above: the existing compact-mode margin-
           tightening style, Grid.compactHeight DockPanel.actionBar, needs to be able to win —
           closes the measured 2-DIP compact+HelpOpen overage). Classes="actionBar" supplies
           the SAME 0,0,0,4 base margin at normal size (pixel-identical), zeroed only in
           compact (same pattern as ReconstructorView's own action DockPanel). -->
      <DockPanel Classes="actionBar">
        <Button DockPanel.Dock="Right"
                Content="Rebuild Sample"
                Command="{Binding RebuildCommand}"
                Classes="primary"
                Padding="16,4" />
      </DockPanel>

      <!-- ── Result banner ─────────────────────────────────────── Visual-only surface,
           capped at 2 lines so a very long ResultSummary (e.g. an
           exception message) can never grow the pinned band past its own budget.
           TextWrapping="Wrap" is what makes MaxLines meaningful (otherwise a single-line,
           NoWrap block never reaches a second line to cap). ToolTip.Tip +
           AutomationProperties.HelpText both carry the FULL, untrimmed summary — same
           visual-only-trim rule as the compact tip (ReconstructorView's own
           TextBlock.tipLine). This element carries NO LiveSetting; the announcement itself
           rides the always-in-tree ResultStatus TextBlock in the log header below
           (visibility-toggling here would race/lose the announcement).
           Padding/Margin are NOT local values (house rule: the Border.resultBanner style
           supplies today's verbatim 8,6 / 0,0,0,4 at normal size, with a measured
           compact-only tightening — see Styles.axaml). -->
      <Border x:Name="ResultBanner" Classes="resultBanner"
              IsVisible="{Binding ShowResult}"
              Background="{Binding ResultSuccess, Converter={StaticResource ResultSuccessToBrush}}"
              CornerRadius="4">
        <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                   ToolTip.Tip="{Binding ResultSummary}"
                   AutomationProperties.HelpText="{Binding ResultSummary}" />
      </Border>

      <Border Classes="pinnedSeparator" Height="1" Background="{DynamicResource BorderSeparator}" />
    </StackPanel>

    <!-- ── Log (fills remaining space) ───────────────────────── -->
    <DockPanel Grid.Row="3">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
        <Button DockPanel.Dock="Right" Content="Save log..."
                Command="{Binding SaveLogCommand}"
                Classes="ghost"
                Padding="8,2" />
        <TextBlock x:Name="LogHeader" DockPanel.Dock="Left" Text="Log" FontWeight="SemiBold" VerticalAlignment="Center" />
        <!-- The two status presenters share ONE Grid (the
             DockPanel's sole remaining/fill child) instead of each being its own
             DockPanel.Dock="Right" item — two same-direction docked TextBlocks left DockPanel's
             own arrange bookkeeping unpredictable under long text in both (observed: the FIRST
             one measured its own full unclipped width, starving the panel's remaining-rect
             tracking so the SECOND rendered at literal zero width).
             FIXED-PROPORTION STAR COLUMNS, not Auto+MaxWidth (an earlier attempt):
             measured that an Auto column's width
             can silently stop tracking its child's DesiredSize when ResultSummary/ShowResult
             change in the SAME tick that also resizes row 2 (the pinned band, a sibling of this
             row-3 Star row) — reproduced down to a minimal case. Correction: this
             requires ResultSummary changing strictly AFTER ShowResult in the same tick, an order
             verified (by grep) to NOT be production's real completion sequence — every
             RebuildAsync completion branch sets ResultSummary before ShowResult — so this is NOT
             "every real rebuild completion" as an earlier version of this comment claimed. The
             Star-Star choice is justified on its own structural merits instead: Star columns
             don't re-derive their width from a child's DesiredSize at all (purely proportional
             to the Grid's own, correctly-updating, total width), so the mechanism is immune to
             this order-sensitivity regardless of whether today's code happens to avoid triggering
             it — a future reordering of RebuildAsync's three lines (or a similar view) cannot
             reintroduce the original starvation bug. Trade-off, accepted: SaveLogStatus's
             share is now a fixed 2/3 of the row (was ~100% when ResultStatus was empty) rather
             than adapting to content; a guaranteed non-zero floor for BOTH, immune to property-
             set order, beats an adaptive split that can silently render one of them invisible. -->
        <Grid ColumnDefinitions="1*,2*">
          <!-- Result announcement: always in the tree, mirrors
               SaveLogStatus's own established pattern exactly — empty text renders nothing, no
               AutomationProperties.Name (the announced name IS the text), LiveSetting=Polite so
               a screen reader is notified the instant ResultSummary transitions from empty to
               text WHILE this element was already realized (the visual banner above toggles
               IsVisible and would race/lose the announcement instead). -->
          <TextBlock Grid.Column="0" x:Name="ResultStatus" Text="{Binding ResultSummary}"
                     AutomationProperties.LiveSetting="Polite"
                     Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
          <!-- Live save-outcome line (4.1.3): always in the tree — visibility-toggling would race
               the announcement; empty text renders nothing. No AutomationProperties.Name: the
               announced name IS the text. -->
          <TextBlock Grid.Column="1" x:Name="SaveLogStatus" Text="{Binding SaveLogAnnouncement}"
                     AutomationProperties.LiveSetting="Polite"
                     Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
        </Grid>
      </DockPanel>
      <ListBox ItemsSource="{Binding LogEntries}"
               Classes="logList"
               AutomationProperties.LabeledBy="{Binding #LogHeader}"
               FontFamily="{DynamicResource MonoFontFamily}"
               FontSize="{DynamicResource MonoFontSize}" />
    </DockPanel>

  </Grid>

</UserControl>
